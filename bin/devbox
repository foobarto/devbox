#!/usr/bin/env bash
#
# devbox — disposable, CWD-mounted dev VMs on Lima/QEMU, preloaded with an
# AI-CLI toolchain (claude, codex, opencode, stado) plus GitHub CLI (`gh`) and
# Homebrew.
#
# Model
#   A one-time "golden" Lima instance per base image carries the toolchain.
#   Each `devbox` run clones the golden into an instance whose name is derived
#   deterministically from the target directory — so a given folder always maps
#   to the same box (one box per folder), and different folders get different
#   boxes. The clone mounts the folder, drops you into a shell, and is deleted
#   on exit unless that invocation uses --keep.
#
# Usage
#   devbox [DIR] [FLAGS]        spin/attach a box for DIR (default: $PWD)
#   devbox gui [DIR] [FLAGS] [-- APP [ARGS...]]
#                               open a GUI-ready shell or run a Wayland app
#   devbox build [--image N|-i N] [--force|-f] [--yes|-y] [--manifest F]
#                                 [--cpus N|-j N] [--memory S|-M S] [--disk S|-D S]
#   devbox ls
#   devbox destroy NAME | --all | --goldens
#   devbox proxy [start|stop|status|audit]   manage the shared host-side proxy
#   devbox sessions [path|clear [--yes]] [DIR]
#                               inspect or remove persistent AI session state
#   devbox --version|-V
#
# Run flags
#   --image NAME, -i NAME
#                    base image for this box's golden (default: ubuntu-24.04).
#                    NAME may be a Lima template name (ubuntu-24.04, debian-12,
#                    fedora, archlinux, …), a template:// URL, a path to a
#                    *.yaml Lima config, or a path/URL to a *.qcow2/*.img image
#                    (e.g. a Kali cloud image).
#   --cpus N, -j N   CPUs for this box (default 4).
#   --memory SIZE, -M SIZE
#                    memory for this box, e.g. 12GiB (default 6GiB).
#   --disk SIZE, -D SIZE
#                    disk ceiling, e.g. 80GiB (default 100GiB). qcow2 is sparse,
#                    so this costs only what is written; it is grow-only.
#   --keep, -k       do not auto-delete the box on shell exit.
#   --ephemeral-sessions, -e
#                    do not attach the project's persistent AI session store
#                    for this box. By default, resumable agent sessions survive
#                    disposal while credentials and unrelated host history do not.
#   --ssh-agent, -s  forward the host SSH agent into the box (git/GitHub auth)
#                    and configure SSH-signed commits; private keys stay host-side.
#   --proxy[=URL], -p[=URL]
#                    point AI CLIs and GitHub CLI at a host-side proxy (default
#                    http://host.lima.internal:4141); real credentials stay on
#                    the host. Auto-starts the proxy on this host if it isn't
#                    already running (shared across boxes). See proxy/README.md.
#   --traffic-audit[=connect|off], -T
#                    opt in to proxy-or-fail web egress. `connect` sets standard
#                    HTTP(S) proxy variables and blocks direct TCP/UDP 80/443
#                    from the guest, leaving the audited host proxy as the way
#                    out. It is separate from -a and may break proxy-unaware
#                    tools; `--traffic-audit=off` removes it from a kept box.
#   --no-auth, -n    do not inject proxy, API-key, or copied host credentials;
#                    also removes devbox-managed proxy/key profiles from an
#                    existing box. This is the default for a new box.
#   --api-keys[=F], -K[=F]
#                    inject API keys into the box from env file F
#                    (default ~/.config/devbox/api-keys.env).
#   --with-creds, -c copy host AI-tool credential files into the box (OAuth
#                    logins for claude/codex without a proxy). Best-effort.
#   --with-agent-config, -g
#                    copy selected non-secret Claude/Codex/OpenCode/Stado
#                    configuration, prompts, rules, and custom agents. Any
#                    file that looks like a credential is skipped.
#   --gui, -G         open the Devbox shell through Waypipe so guest GUI apps
#                    appear in the host Wayland session. With `-- APP`, run
#                    just that GUI application instead of opening a shell.
#                    `-g` remains --with-agent-config for compatibility.
#   -a               shortcut for --with-agent-config --proxy --ssh-agent.
#   --mount P[:ro|:rw], -m P[:ro|:rw]
#                    mount an extra host path into the box at the same path
#                    (default ro). Repeatable. Applied at box creation.
#   --copy SRC[:DEST], -C SRC[:DEST]
#                    copy an extra host file/dir into the box (DEST defaults
#                    to the basename in $HOME). Repeatable. Works on new+existing.
#   --name NAME, -N NAME
#                    override the derived instance name.
#
# GUI
#   `devbox gui` / --gui run a shell or a Wayland application through Waypipe
#   over the existing Lima SSH transport. The host must be in a Wayland session
#   with `waypipe` installed. Waypipe is installed in a new golden and on
#   demand in a kept guest created by an older golden. Direct host
#   Wayland-socket mounts are deliberately not used.
#
# Project manifest (.devbox.toml)
#   image  = "ubuntu-24.04"          shorthand, or the table form:
#   [image]
#   location = "/path/kali.qcow2"    template name, template://, *.yaml, *.qcow2, URL
#   digest   = "sha512:…"            optional, for qcow2/URL images
#   provision      = "…"             optional, root script baked into the golden
#   provision_user = "…"             optional, user script baked into the golden
#   [resources]
#   cpus = 8 / memory = "12GiB" / disk = "80GiB"
#   Custom provisioning changes the golden's identity, so a project cannot
#   redefine the golden another project clones from.
#
# Env
#   DEVBOX_CONFIG_DIR   config/golden dir (default ~/.config/devbox)
#   DEVBOX_SESSION_DIR  persistent per-project AI session root
#                       (default $XDG_STATE_HOME/devbox/sessions, falling back
#                       to ~/.local/state/devbox/sessions)
#   DEVBOX_PROXY_URL    default --proxy URL
#   DEVBOX_BUILD_TIMEOUT
#                       how long a golden build may take (default 90m). Lima's
#                       own default is 10m, which heavy [image].provision blows
#                       through — leaving a VM provisioning behind a failed start.
#
# Global config (~/.config/devbox/config.toml)
#   [resources] cpus/memory/disk — machine-wide defaults, overridden by a
#   project manifest, which is overridden by the CLI flags above.
#
set -euo pipefail

# ---------------------------------------------------------------- constants --
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VERSION_FILE="$SCRIPT_DIR/../VERSION"
DEVBOX_VERSION="$(tr -d '[:space:]' < "$VERSION_FILE" 2>/dev/null || printf 'dev')"
DEFAULT_IMAGE="ubuntu-24.04"
# Resource defaults. `disk` is a ceiling, not an allocation: Lima's qcow2 is
# sparse, so a 100GiB box that has written 3GiB occupies 3GiB on the host. It is
# also grow-only — qcow2 cannot shrink — so the default is generous on purpose,
# to avoid a mid-engagement resize.
DEFAULT_CPUS=4
DEFAULT_MEMORY="6GiB"
DEFAULT_DISK="100GiB"
# Lima gives boot scripts 10 minutes, then fails the start with "did not receive
# an event with the running status" — while the VM keeps provisioning, orphaned.
# Baking a distro toolchain into a golden (e.g. kali-linux-headless) routinely
# exceeds that, so golden builds get a much longer ceiling.
DEFAULT_BUILD_TIMEOUT="${DEVBOX_BUILD_TIMEOUT:-90m}"
CONFIG_DIR="${DEVBOX_CONFIG_DIR:-$HOME/.config/devbox}"
GLOBAL_CONFIG="$CONFIG_DIR/config.toml"
DEFAULT_KEYS_FILE="$CONFIG_DIR/api-keys.env"
AGENT_SESSION_BASE="${DEVBOX_SESSION_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/devbox/sessions}"
PROXY_DEFAULT_URL="${DEVBOX_PROXY_URL:-http://host.lima.internal:4141}"
# A GitHub proxy capability is valid for eight hours. Refresh it well before
# expiry while this host-side `devbox` session remains attached to the guest.
GH_PROXY_CAPABILITY_RENEW_SECONDS="${DEVBOX_GH_PROXY_CAPABILITY_RENEW_SECONDS:-25200}"
PROJECT_MANIFEST_NAME=".devbox.toml"

# Host credential paths copied into the box under --with-creds (best-effort;
# only those that exist are copied). Tune to taste. Deliberately excludes
# ~/.ssh / ~/.gnupg — use --ssh-agent for git, and never ship private keys.
CRED_PATHS=(
  "$HOME/.claude.json"
  "$HOME/.claude/.credentials.json"
  "$HOME/.codex/auth.json"
  "$HOME/.codex/config.toml"
  "$HOME/.config/opencode"
  "$HOME/.local/share/opencode/auth.json"
  "$HOME/.config/stado"
)

# Non-secret agent configuration copied under --with-agent-config. This is
# deliberately an allowlist: histories, sessions, caches, auth files, and
# Stado's key directory never cross the VM boundary. Directories are expanded
# to regular files one at a time, so a suspect file can be skipped safely.
AGENT_CONFIG_PATHS=(
  "$HOME/.claude/CLAUDE.md"
  "$HOME/.claude/settings.json"
  "$HOME/.claude/settings.local.json"
  "$HOME/.claude/commands"
  "$HOME/.claude/agents"
  "$HOME/.claude/skills"
  "$HOME/.claude/hooks"
  "$HOME/.codex/AGENTS.md"
  "$HOME/.codex/config.toml"
  "$HOME/.codex/rules"
  "$HOME/.codex/hooks.json"
  "$HOME/.config/opencode/opencode.json"
  "$HOME/.config/opencode/opencode.jsonc"
  "$HOME/.config/opencode/commands"
  "$HOME/.config/opencode/agents"
  "$HOME/.config/opencode/plugins"
  "$HOME/.config/stado/config.toml"
  "$HOME/.config/stado/system-prompt.md"
)

# ------------------------------------------------------------------- output --
_c() { [[ -t 2 ]] && printf '\033[%sm' "$1" >&2 || true; }
log()  { _c '1;34'; printf '[devbox]'   >&2; _c 0; printf ' %s\n' "$*" >&2; }
warn() { _c '1;33'; printf '[devbox] WARN:' >&2; _c 0; printf ' %s\n' "$*" >&2; }
die()  { _c '1;31'; printf '[devbox] ERROR:' >&2; _c 0; printf ' %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

abspath() { readlink -f -- "$1" 2>/dev/null || printf '%s' "$1"; }

# ------------------------------------------------------------------ sizes --
# Lima's --cpus/--memory/--disk flags take GiB numbers, while its YAML and this
# tool's config speak human sizes ("12GiB"). A bare number means GiB.
size_to_gib() { # $1 size -> GiB as a number
  python3 - "${1:-}" <<'PY'
import re, sys
s = sys.argv[1].strip()
m = re.fullmatch(r'(\d+(?:\.\d+)?)\s*([KMGT]iB|[KMGT]B|B)?', s, re.I)
if not m:
    raise SystemExit(f"invalid size: {s!r} (use e.g. 8GiB, 512MiB, or a bare number of GiB)")
n, unit = float(m.group(1)), (m.group(2) or "GiB").upper()
mult = {"B": 1 / 1024 ** 3, "KIB": 1 / 1024 ** 2, "KB": 1 / 1024 ** 2,
        "MIB": 1 / 1024, "MB": 1 / 1024, "GIB": 1, "GB": 1, "TIB": 1024, "TB": 1024}[unit]
v = n * mult
print(int(v) if v == int(v) else v)
PY
}

# Precedence: CLI flag > project manifest > global config.toml > built-in.
resolve_resources() { # $1 cli_cpus $2 cli_mem $3 cli_disk $4 manifest_json $5 global_json
  python3 - "${1:-}" "${2:-}" "${3:-}" "${4:-{\}}" "${5:-{\}}" \
           "$DEFAULT_CPUS" "$DEFAULT_MEMORY" "$DEFAULT_DISK" <<'PY'
import json, sys
cli = sys.argv[1:4]
manifest = json.loads(sys.argv[4] or "{}")
globalcfg = json.loads(sys.argv[5] or "{}")
defaults = sys.argv[6:9]
print("\t".join(
    str(cli[i] or manifest.get(k) or globalcfg.get(k) or defaults[i])
    for i, k in enumerate(("cpus", "memory", "disk"))
))
PY
}

# Machine-wide defaults, so a resource preference is set once rather than per
# project. Absent or unreadable file is not an error — it is simply no opinion.
global_config_json() {
  [[ -r "$GLOBAL_CONFIG" ]] || { printf '{}'; return 0; }
  python3 - "$GLOBAL_CONFIG" <<'PY' 2>/dev/null || printf '{}'
import json, sys, tomllib
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text()).get("resources", {})
print(json.dumps({k: v for k, v in data.items() if k in ("cpus", "memory", "disk")}))
PY
}

# -------------------------------------------------------------- name helpers --
_slug() { # sanitize $1 -> lowercase [a-z0-9-], collapse, trim, cap length $2
  local s; s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
      | tr -c 'a-z0-9' '-' | sed -E 's/-+/-/g; s/^-|-$//g')"
  [[ -z "$s" ]] && s="x"
  printf '%s' "${s:0:${2:-30}}"
}

imgslug() { # stable short slug for an image spec (name or path/URL)
  local img="$1" base; base="$(_slug "$(basename -- "$img")" 20)"
  case "$img" in
    */*|*.qcow2|*.img|*.raw)
      printf '%s-%s' "$base" "$(printf '%s' "$img" | sha1sum | cut -c1-6)";;
    *) printf '%s' "$(_slug "$img" 30)";;
  esac
}

# A golden is shared across every project using the same image, so anything that
# changes what gets baked into it must change its identity. Otherwise a project
# manifest could silently redefine — or poison — the golden another project
# clones from. A stock image (no digest, no custom provisioning) hashes to
# nothing and keeps its historical name, so existing goldens are not orphaned.
golden_spec_hash() { # $1 location $2 digest $3 provision $4 provision_user
  local digest="${2:-}" provision="${3:-}" provision_user="${4:-}"
  [[ -n "$digest$provision$provision_user" ]] || return 0
  printf '%s\0%s\0%s\0%s' "$1" "$digest" "$provision" "$provision_user" \
    | sha1sum | cut -c1-6
}

golden_name() { # $1 image [$2 spec hash]
  local hash="${2:-}"
  printf 'devbox-golden-%s%s' "$(imgslug "$1")" "${hash:+-$hash}"
}

instance_name() { # deterministic per (image, absolute dir)
  local image="$1" dir="$2" slug hash
  slug="$(_slug "$(basename -- "$dir")" 24)"
  hash="$(printf '%s\0%s' "$image" "$dir" | sha1sum | cut -c1-8)"
  printf 'devbox-%s-%s' "$slug" "$hash"
}

# Session state follows the project rather than the disposable VM or selected
# image. The longer hash avoids two same-named projects ever sharing transcripts
# accidentally, while the slug keeps the host-side directory understandable.
project_session_key() { # $1 absolute project directory
  local dir="$1" slug hash
  slug="$(_slug "$(basename -- "$dir")" 32)"
  hash="$(printf '%s' "$dir" | sha256sum | cut -c1-16)"
  printf '%s-%s' "$slug" "$hash"
}

agent_session_base() {
  python3 - "$AGENT_SESSION_BASE" <<'PY'
import os
import sys
print(os.path.realpath(os.path.abspath(os.path.expanduser(sys.argv[1]))))
PY
}

project_session_dir() { # $1 absolute project directory
  local base
  base="$(agent_session_base)"
  printf '%s/%s' "$base" "$(project_session_key "$1")"
}

validate_session_path() { # $1 exact per-project host directory
  local path="$1" base
  base="$(agent_session_base)"
  case "$base" in
    /|"$HOME"|"$HOME/.ssh"|"$HOME/.ssh/"*|"$HOME/.pki"|"$HOME/.pki/"*|"$HOME/.sigstore"|"$HOME/.sigstore/"*|"$HOME/.gnupg"|"$HOME/.gnupg/"*)
      die "unsafe DEVBOX_SESSION_DIR: $base"
      ;;
  esac
  [[ "$path" == "$base/"* && "$(dirname -- "$path")" == "$base" ]] \
    || die "refusing non-project session path: $path"
}

prepare_session_dir() { # $1 exact per-project host directory
  local path="$1" base owner old_umask
  base="$(agent_session_base)"
  validate_session_path "$path"
  old_umask="$(umask)"
  umask 077
  mkdir -p -- "$base"
  [[ -d "$base" && ! -L "$base" ]] || die "session root must be a real directory: $base"
  owner="$(stat -c %u "$base" 2>/dev/null || true)"
  [[ "$owner" == "$(id -u)" ]] || die "session root is not owned by the current user: $base"
  chmod 700 -- "$base"
  if [[ -e "$path" || -L "$path" ]]; then
    [[ -d "$path" && ! -L "$path" ]] || die "project session path must be a real directory: $path"
  else
    mkdir -- "$path"
  fi
  chmod 700 -- "$path"
  umask "$old_umask"
}

# ---------------------------------------------------------------- lima state --
instance_exists() { limactl list -q 2>/dev/null | grep -qx "$1"; }
instance_status() { limactl list "$1" --format '{{.Status}}' 2>/dev/null || echo Unknown; }
ensure_golden_stopped() {
  [[ "$(instance_status "$1")" == "Running" ]] || return 0
  log "Stopping golden $1 before clone"; limactl stop "$1"
}

session_mount_enabled() { # $1 instance $2 exact host state directory
  limactl list "$1" --json 2>/dev/null | python3 -c '
import json, sys
path = sys.argv[1]
try:
    item = json.load(sys.stdin)
    if isinstance(item, list):
        item = item[0] if item else {}
    mounts = item.get("config", {}).get("mounts", [])
    print(any(m.get("location") == path and m.get("writable") is True for m in mounts))
except (json.JSONDecodeError, AttributeError, IndexError, TypeError):
    print(False)
' "$2"
}

session_mount_present() { # $1 instance $2 exact host state directory
  limactl list "$1" --json 2>/dev/null | python3 -c '
import json, sys
path = sys.argv[1]
try:
    item = json.load(sys.stdin)
    if isinstance(item, list):
        item = item[0] if item else {}
    mounts = item.get("config", {}).get("mounts", [])
    print(any(m.get("location") == path for m in mounts))
except (json.JSONDecodeError, AttributeError, IndexError, TypeError):
    print(False)
' "$2"
}

ensure_session_mount() { # $1 existing instance $2 exact host state directory
  local name="$1" path="$2" status
  [[ "$(session_mount_enabled "$name" "$path")" == True ]] && return 0
  status="$(instance_status "$name")"
  if [[ "$status" == Running ]]; then
    log "Restarting $name once to attach persistent AI session state"
    limactl stop "$name"
  fi
  log "Attaching persistent AI session state to $name"
  limactl edit "$name" --mount "$path:w" >/dev/null
  [[ "$status" == Running ]] && limactl start "$name"
}

remove_session_mount() { # $1 existing instance $2 exact host state directory
  local name="$1" path="$2" status quoted
  [[ "$(session_mount_present "$name" "$path")" == True ]] || return 0
  status="$(instance_status "$name")"
  if [[ "$status" == Running ]]; then
    log "Restarting $name once to detach persistent AI session state"
    limactl stop "$name"
  fi
  quoted="$(python3 -c 'import json, sys; print(json.dumps(sys.argv[1]))' "$path")"
  limactl edit "$name" --set "del(.mounts[] | select(.location == $quoted))" >/dev/null
  [[ "$status" == Running ]] && limactl start "$name"
}

require_ssh_agent() {
  [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK:-}" ]] || \
    die "--ssh-agent needs a running host SSH agent (SSH_AUTH_SOCK is unset or not a socket)"
}

ssh_agent_forwarding_enabled() {
  limactl list "$1" --json 2>/dev/null | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin)["config"]["ssh"]["forwardAgent"] is True)
except (json.JSONDecodeError, KeyError, TypeError):
    print(False)
'
}

enable_ssh_agent() { # $1 instance; restart only when its persisted config changes
  local name="$1" status
  require_ssh_agent
  [[ "$(ssh_agent_forwarding_enabled "$name")" == True ]] && return 0

  status="$(instance_status "$name")"
  if [[ "$status" == "Running" ]]; then
    log "Restarting $name to enable host SSH-agent forwarding"
    limactl stop "$name"
  fi
  log "Enabling host SSH-agent forwarding"
  limactl edit "$name" --set '.ssh.forwardAgent = true' >/dev/null
  [[ "$status" == "Running" ]] && limactl start "$name"
}

ssh_signing_public_key() {
  local key
  key="$(ssh-add -L 2>/dev/null | sed -n '1p')"
  [[ -n "$key" ]] || die "--ssh-agent needs an identity loaded in the host SSH agent to sign Git commits"
  printf '%s\n' "$key" | ssh-keygen -lf - >/dev/null 2>&1 \
    || die "the first identity from the host SSH agent is not a valid SSH public key"
  printf '%s' "$key"
}

apply_git_signing() { # $1 instance; SSH signatures use the forwarded agent
  local name="$1" key git_name git_email
  key="$(ssh_signing_public_key)"
  git_name="$(git config --global --get user.name 2>/dev/null || true)"
  git_email="$(git config --global --get user.email 2>/dev/null || true)"
  [[ -n "$git_name" && -n "$git_email" ]] || \
    die "configure host Git user.name and user.email before using --ssh-agent for signed commits"
  log "Configuring Git SSH commit signing through the forwarded agent"
  python3 - "$key" "$git_name" "$git_email" <<'PY' \
    | limactl shell "$name" -- python3 -c '
import json
import pathlib
import subprocess
import sys

config = json.load(sys.stdin)
devbox_dir = pathlib.Path.home() / ".devbox"
devbox_dir.mkdir(mode=0o700, exist_ok=True)
public_key = devbox_dir / "git-signing-key.pub"
allowed_signers = devbox_dir / "git-allowed-signers"
public_key.write_text(config["key"] + "\n")
public_key.chmod(0o644)
allowed_signers.write_text("{} namespaces=\"git\" {}\n".format(config["email"], config["key"]))
allowed_signers.chmod(0o644)

def set_global(key, value):
    subprocess.run(["git", "config", "--global", key, value], check=True)

# Git 2.34+ can delegate SSH-format signatures to SSH_AUTH_SOCK. Only the
# public key crosses into the guest; ssh-keygen asks the forwarded agent to sign.
set_global("gpg.format", "ssh")
set_global("user.signingkey", str(public_key))
set_global("gpg.ssh.allowedSignersFile", str(allowed_signers))
set_global("commit.gpgsign", "true")
for key, value in (("user.name", config["name"]), ("user.email", config["email"])):
    current = subprocess.run(
        ["git", "config", "--global", "--get", key], text=True, capture_output=True
    )
    if current.returncode != 0 or not current.stdout.strip():
        set_global(key, value)
'
import json
import sys
print(json.dumps({"key": sys.argv[1], "name": sys.argv[2], "email": sys.argv[3]}))
PY
}

# ---------------------------------------------------------- golden yaml gen --
emit_base_stanza() { # $1 image [$2 digest]
  local image="$1" digest="${2:-}" t
  case "$image" in
    http://*|https://*)   printf 'images:\n- location: "%s"\n  arch: "x86_64"\n' "$image"
                          [[ -n "$digest" ]] && printf '  digest: "%s"\n' "$digest";;
    template:*)           t="${image#template:}"; t="${t#//}"; printf 'base: "template:%s"\n' "$t";;
    *.yaml|*.yml)         printf 'base: "%s"\n' "$(abspath "$image")";;
    *.qcow2|*.img|*.raw)  printf 'images:\n- location: "%s"\n  arch: "x86_64"\n' "$(abspath "$image")"
                          [[ -n "$digest" ]] && printf '  digest: "%s"\n' "$digest";;
    *)                    printf 'base: "template:%s"\n' "$image";;
  esac
  return 0
}

# Render one Lima provision entry, indenting the script into the block scalar.
# A shebang is supplied when the author did not write one, so a bare command
# list behaves the way people expect rather than running under /bin/sh.
emit_provision_entry() { # $1 mode $2 script
  printf -- '- mode: %s\n  script: |\n' "$1"
  { [[ "$2" == '#!'* ]] || printf '#!/bin/bash\n'; printf '%s\n' "$2"; } | sed 's/^/    /'
}

# Project provisioning is deliberately NOT rendered here — see
# apply_golden_provisioning for why it runs after boot instead. Trailing
# provisioning arguments are accepted and ignored so callers can pass the whole
# golden spec in one place.
emit_golden_yaml() { # $1 image $2 outfile [$3 cpus $4 memory $5 disk $6 digest]
  local image="$1" out="$2"
  local cpus="${3:-$DEFAULT_CPUS}" memory="${4:-$DEFAULT_MEMORY}" disk="${5:-$DEFAULT_DISK}"
  local digest="${6:-}"
  {
    printf '# devbox golden — regenerate with: devbox build --image %s --force\n' "$image"
    emit_base_stanza "$image" "$digest"
    printf 'cpus: %s\nmemory: "%s"\ndisk: "%s"\n' "$cpus" "$memory" "$disk"
    cat <<'YAML'
mountType: "virtiofs"
# Devbox does not require a container runtime. Disabling Lima's optional
# rootless-containerd bootstrap keeps golden provisioning deterministic and
# avoids installing an otherwise unused daemon and image store.
containerd:
  system: false
  user: false
# No host mount on the golden — the per-run CWD mount is added at clone time and
# would otherwise overlap the stock template's ~ mount.
mounts: []
ssh:
  loadDotSSHPubKeys: false   # host pubkeys are not copied in; use --ssh-agent
provision:
- mode: system
  script: |
    #!/bin/bash
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive
    # Lima's default user network exposes its host-aware DNS resolver at
    # 192.168.5.3. Kali's cloud image accepts the DHCP route but, via
    # ifupdown, can drop its DHCP DNS option, leaving systemd-resolved with no
    # upstream server at all. Configure the documented Lima resolver as the
    # global fallback before any package setup. It preserves host VPN and
    # split-DNS resolution instead of hard-coding a public resolver.
    if command -v resolvectl >/dev/null 2>&1 \
       && systemctl is-active --quiet systemd-resolved; then
      install -d -m 755 /etc/systemd/resolved.conf.d
      cat > /etc/systemd/resolved.conf.d/99-devbox-host-dns.conf <<'RESOLVER'
    [Resolve]
    DNS=192.168.5.3
    RESOLVER
      systemctl restart systemd-resolved
    fi
    apt="build-essential git curl wget jq ripgrep unzip ca-certificates procps file locales sudo python3 python3-venv python3-pip waypipe nftables bubblewrap passt apparmor apparmor-profiles"
    dnf="@development-tools git curl wget jq ripgrep unzip ca-certificates procps-ng file glibc-langpack-en sudo python3 python3-pip waypipe nftables bubblewrap passt"
    pac="base-devel git curl wget jq ripgrep unzip ca-certificates procps-ng file sudo python python-pip waypipe nftables bubblewrap passt"
    if   command -v apt-get >/dev/null 2>&1; then apt-get update && apt-get install -y --no-install-recommends $apt
    elif command -v dnf     >/dev/null 2>&1; then dnf install -y $dnf
    elif command -v pacman  >/dev/null 2>&1; then pacman -Sy --noconfirm $pac
    fi
    # Ubuntu 24.04 restricts unprivileged user namespaces through a generic
    # AppArmor policy. Stado's Linux sandbox needs bwrap to construct private
    # mount/pid/network namespaces. Enable AppArmor's dedicated bwrap policy:
    # it permits bwrap's short-lived setup capabilities, then stacks a more
    # restrictive profile on the sandboxed child. Do not weaken the global
    # restriction: standalone unshare remains unavailable.
    if [[ -r /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]] \
       && [[ "$(</proc/sys/kernel/apparmor_restrict_unprivileged_userns)" == 1 ]] \
       && [[ -x /usr/sbin/apparmor_parser ]] \
       && [[ -r /usr/share/apparmor/extra-profiles/bwrap-userns-restrict ]]; then
      install -D -m 0644 /usr/share/apparmor/extra-profiles/bwrap-userns-restrict \
        /etc/apparmor.d/bwrap-userns-restrict
      /usr/sbin/apparmor_parser -r /etc/apparmor.d/bwrap-userns-restrict
    fi
- mode: user
  script: |
    #!/bin/bash
    set -euo pipefail
    # PATH + brew shellenv for every login shell (bash/zsh/sh).
    for rc in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
      touch "$rc"
      grep -q 'linuxbrew/.linuxbrew/bin/brew shellenv' "$rc" 2>/dev/null || \
        echo 'eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"' >> "$rc"
      grep -q 'devbox PATH' "$rc" 2>/dev/null || \
        echo 'export PATH="$HOME/.local/bin:$HOME/go/bin:$HOME/.opencode/bin:$PATH" # devbox PATH' >> "$rc"
    done
    # Trust GitHub's published SSH host keys before any clone/push. Prefer the
    # Meta API; its unauthenticated quota can be exhausted behind a shared NAT,
    # so fall back to GitHub's official fingerprint documentation over HTTPS.
    # Never use ssh-keyscan here: it would make first contact vulnerable to MITM.
    github_hosts="$(mktemp)"
    if ! curl --fail --silent --show-error --retry 3 \
      --header 'Accept: application/vnd.github+json' \
      --header 'X-GitHub-Api-Version: 2022-11-28' \
      --user-agent 'devbox-golden-hostkeys' \
      https://api.github.com/meta \
      | jq -er '.ssh_keys[] | "github.com \(.)"' > "$github_hosts"; then
      printf '%s\n' 'GitHub Meta API unavailable; using GitHub Docs host-key fallback.' >&2
      curl --fail --silent --show-error --retry 3 \
        https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/githubs-ssh-key-fingerprints \
        | grep -oE 'ssh-(ed25519|rsa) [A-Za-z0-9+/=]+|ecdsa-sha2-nistp256 [A-Za-z0-9+/=]+' \
        | sort -u \
        | sed 's/^/github.com /' > "$github_hosts"
    fi
    test -s "$github_hosts"
    install -d -m 700 "$HOME/.ssh"
    touch "$HOME/.ssh/known_hosts"
    chmod 600 "$HOME/.ssh/known_hosts"
    while IFS= read -r host_key; do
      grep -Fqx "$host_key" "$HOME/.ssh/known_hosts" || printf '%s\n' "$host_key" >> "$HOME/.ssh/known_hosts"
    done < "$github_hosts"
    rm -f "$github_hosts"
    # --- Homebrew (Linuxbrew): distro-agnostic base for the AI CLIs ---
    if [ ! -x /home/linuxbrew/.linuxbrew/bin/brew ] && ! command -v brew >/dev/null 2>&1; then
      NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || true
    fi
    BREW="$(command -v brew || echo /home/linuxbrew/.linuxbrew/bin/brew)"
    [ -x "$BREW" ] && eval "$("$BREW" shellenv)" || true
    export PATH="$HOME/.local/bin:$HOME/go/bin:$HOME/.opencode/bin:$PATH"
    # --- AI CLIs, terminal agent multiplexer, and GitHub CLI ---
    brew install codex || true
    brew install gh || true
    brew install sst/tap/opencode || curl -fsSL https://opencode.ai/install | bash || true
    # Pi Coding Agent is distributed through npm.  The package does not need
    # lifecycle scripts for normal use, so keep third-party install hooks off.
    command -v npm >/dev/null 2>&1 || brew install node || true
    command -v pi >/dev/null 2>&1 || \
      npm install -g --ignore-scripts @earendil-works/pi-coding-agent || true
    # Herdr is a standalone terminal agent multiplexer.
    command -v herdr >/dev/null 2>&1 || brew install herdr || true
    # stado — Homebrew cask (installs on Linux for this binary cask). Fallback to
    # a Go source install only if the cask ever fails (installs go on demand).
    if ! command -v stado >/dev/null 2>&1; then
      brew install --cask foobarto/tap/stado \
        || { brew install go && GOBIN="$HOME/.local/bin" go install github.com/foobarto/stado/cmd/stado@latest; } \
        || true
    fi
    # claude code — official native installer (-> ~/.local/bin)
    command -v claude >/dev/null 2>&1 || { curl -fsSL https://claude.ai/install.sh | bash || true; }
YAML
  } > "$out"
}

# Project-supplied provisioning runs AFTER the golden has booted, not as a Lima
# `provision` entry. Lima fails a start whose boot scripts outrun its readiness
# wait — reporting "did not receive an event with the running status", or marking
# the instance degraded — and `limactl start --timeout` does not extend that
# wait. Baking a distro toolchain (kali-linux-headless and friends) reliably
# exceeds it, so devbox owns this phase: it can take as long as it needs and its
# output is visible instead of buried in cloud-init's log.
#
# Scripts are piped to `bash -s` rather than passed as arguments so that quoting
# and newlines survive intact.
apply_golden_provisioning() { # $1 golden $2 system script $3 user script
  local golden="$1" system="${2:-}" user="${3:-}"
  if [[ -n "$system" ]]; then
    log "Applying project system provisioning to $golden (this can take a while)…"
    printf '%s\n' "$system" \
      | limactl shell "$golden" -- sudo DEBIAN_FRONTEND=noninteractive bash -s \
      || die "project system provisioning failed"
  fi
  if [[ -n "$user" ]]; then
    log "Applying project user provisioning to $golden…"
    printf '%s\n' "$user" \
      | limactl shell "$golden" -- bash -l -s \
      || die "project user provisioning failed"
  fi
}

verify_golden() {
  local name="$1" out host_keys
  # shellcheck disable=SC2016 # $t and $(...) expand in the guest shell.
  out="$(limactl shell "$name" -- bash -lc '
    for t in brew gh claude codex opencode pi herdr stado bwrap pasta; do
      if command -v "$t" >/dev/null 2>&1; then printf "  ok   %-9s %s\n" "$t" "$(command -v "$t")"
      else printf "  MISS %-9s (not on PATH)\n" "$t"; fi
    done' </dev/null 2>/dev/null || true)"
  printf '%s\n' "$out" >&2
  if printf '%s' "$out" | grep -q MISS; then
    warn "some tools missing in golden — inspect with: limactl shell $name"
  fi
  # Stado's Linux sandbox uses bwrap for process/filesystem isolation and
  # `pasta --splice-only` for proxy-only host allowlist networking. Exercise
  # both in the golden: Ubuntu's AppArmor exception is deliberately scoped to
  # bwrap, so a standalone `unshare` probe would correctly remain blocked.
  if ! limactl shell "$name" -- bash -lc '
    bwrap --unshare-user --unshare-net --uid 0 --gid 0 --ro-bind / / true
    pasta --help 2>&1 | grep -q -- "--splice-only"
  ' </dev/null 2>/dev/null; then
    warn "golden sandbox prerequisites are unusable (bwrap/pasta)"
    return 1
  fi
  # shellcheck disable=SC2016 # $HOME expands in the guest shell.
  host_keys="$(limactl shell "$name" -- bash -lc '
    test -s "$HOME/.ssh/known_hosts"
    ssh-keygen -F github.com -f "$HOME/.ssh/known_hosts"
  ' </dev/null 2>/dev/null || true)"
  if [[ "$(printf '%s\n' "$host_keys" | grep -c '^github.com ')" -lt 3 ]]; then
    warn "golden is missing GitHub's published SSH host keys"
    return 1
  fi
}

# ------------------------------------------------------------- auth wiring ---
# --- host-side AI proxy lifecycle (auto-started by --proxy) ----------------
# port of a proxy URL (default 4141)
proxy_port() {
  local hp="${1#*://}"; hp="${hp%%/*}"
  case "$hp" in *:*) printf '%s' "${hp##*:}";; *) printf '4141';; esac
}
# $1 bare http proxy URL; capability token arrives on stdin so it never appears
# in the host process list. HTTP proxy URLs encode userinfo as Basic auth.
capability_proxy_url() {
  python3 -c '
import sys
from urllib.parse import quote, urlsplit, urlunsplit

source = urlsplit(sys.argv[1])
token = sys.stdin.read().strip()
if source.scheme != "http" or not source.netloc or source.username or source.password or source.path or source.query or source.fragment:
    raise SystemExit("proxy URL must be a bare http://host:port URL")
if not token:
    raise SystemExit("proxy capability is empty")
print(urlunsplit((source.scheme, f"{quote(token)}@{source.netloc}", "", "", "")))
' "$1"
}

github_proxy_url() { capability_proxy_url "$@"; }
traffic_proxy_url() { capability_proxy_url "$@"; }

gh_proxy_state_path() { # $1 Lima instance name
  [[ "$1" =~ ^[[:alnum:]_.-]+$ ]] || die "invalid Devbox instance name for GitHub proxy state"
  printf '%s/gh-proxy-boxes/%s.url' "$CONFIG_DIR" "$1"
}

valid_gh_proxy_endpoint() { # $1 bare http proxy URL
  python3 -c '
import sys
from urllib.parse import urlsplit

source = urlsplit(sys.argv[1])
sys.exit(0 if source.scheme == "http" and source.netloc and not source.username and not source.password and not source.path and not source.query and not source.fragment else 1)
' "$1"
}

traffic_proxy_state_path() { # $1 Lima instance name
  [[ "$1" =~ ^[[:alnum:]_.-]+$ ]] || die "invalid Devbox instance name for traffic proxy state"
  printf '%s/traffic-proxy-boxes/%s.url' "$CONFIG_DIR" "$1"
}

record_traffic_proxy_endpoint() { # $1 Lima instance $2 bare http proxy URL
  local name="$1" url="$2" state_dir path tmp
  valid_gh_proxy_endpoint "$url" || die "traffic proxy URL must be a bare http://host:port URL"
  path="$(traffic_proxy_state_path "$name")"
  state_dir="$(dirname "$path")"
  umask 077
  install -d -m 700 "$state_dir"
  tmp="$(mktemp "$state_dir/.${name}.XXXXXX")"
  printf '%s\n' "$url" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$path"
}

stored_traffic_proxy_endpoint() { # $1 Lima instance; prints host-owned remembered endpoint
  local path value
  path="$(traffic_proxy_state_path "$1")"
  [[ -r "$path" ]] || return 1
  value="$(<"$path")"
  if ! valid_gh_proxy_endpoint "$value"; then
    warn "ignoring invalid remembered traffic proxy endpoint for $1"
    return 1
  fi
  printf '%s' "$value"
}

clear_traffic_proxy_endpoint() { # $1 Lima instance
  rm -f -- "$(traffic_proxy_state_path "$1")"
}

record_gh_proxy_endpoint() { # $1 Lima instance $2 bare http proxy URL
  local name="$1" url="$2" state_dir path tmp
  valid_gh_proxy_endpoint "$url" || die "GitHub CLI proxy URL must be a bare http://host:port URL"
  path="$(gh_proxy_state_path "$name")"
  state_dir="$(dirname "$path")"
  umask 077
  install -d -m 700 "$state_dir"
  tmp="$(mktemp "$state_dir/.${name}.XXXXXX")"
  printf '%s\n' "$url" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$path"
}

stored_gh_proxy_endpoint() { # $1 Lima instance; prints host-owned remembered endpoint
  local path value
  path="$(gh_proxy_state_path "$1")"
  [[ -r "$path" ]] || return 1
  value="$(<"$path")"
  if ! valid_gh_proxy_endpoint "$value"; then
    warn "ignoring invalid remembered GitHub CLI proxy endpoint for $1"
    return 1
  fi
  printf '%s' "$value"
}

clear_gh_proxy_endpoint() { # $1 Lima instance
  rm -f -- "$(gh_proxy_state_path "$1")"
}

write_gh_proxy_url() { # $1 Lima instance $2 full capability-bearing proxy URL
  local name="$1" url="$2"
  # Pass the capability on stdin, never as a guest command argument or env var.
  # The wrapper reads this atomically replaced, owner-only file for each `gh`
  # invocation, so a renewed capability is immediately effective in existing
  # shells without rewriting their environment.
  # shellcheck disable=SC2016 # $HOME and command substitutions expand in the guest.
  printf '%s\n' "$url" | limactl shell "$name" -- bash -c '
    set -e
    state_dir="$HOME/.devbox/gh-proxy"
    umask 077
    install -d -m 700 "$state_dir"
    tmp="$(mktemp "$state_dir/.proxy-url.XXXXXX")"
    cat > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$state_dir/proxy-url"
  '
}

renew_gh_proxy_capability() { # $1 Lima instance $2 bare http proxy URL
  local name="$1" url="$2" launcher gh_proxy_token gh_proxy_url
  launcher="$(proxy_launcher)" || { warn "GitHub CLI proxy launcher not found"; return 1; }
  gh_proxy_token="$("$launcher" --new-gh-proxy-token)" || {
    warn "could not renew GitHub CLI proxy capability"
    return 1
  }
  [[ "$gh_proxy_token" == *.* ]] || {
    warn "GitHub CLI proxy returned an invalid renewed capability"
    return 1
  }
  gh_proxy_url="$(printf '%s' "$gh_proxy_token" | github_proxy_url "$url")" || {
    warn "could not configure renewed GitHub CLI proxy URL"
    return 1
  }
  write_gh_proxy_url "$name" "$gh_proxy_url" || {
    warn "could not deliver renewed GitHub CLI proxy capability to $name"
    return 1
  }
}

start_gh_proxy_capability_renewal() { # $1 Lima instance $2 bare http proxy URL
  local name="$1" url="$2"
  [[ "$GH_PROXY_CAPABILITY_RENEW_SECONDS" =~ ^[1-9][0-9]*$ ]] || \
    die "DEVBOX_GH_PROXY_CAPABILITY_RENEW_SECONDS must be a positive number of seconds"
  (
    while sleep "$GH_PROXY_CAPABILITY_RENEW_SECONDS"; do
      [[ "$(instance_status "$name")" == "Running" ]] || continue
      proxy_ensure "$url"
      renew_gh_proxy_capability "$name" "$url" || \
        warn "GitHub CLI proxy capability renewal failed; retrying in ${GH_PROXY_CAPABILITY_RENEW_SECONDS}s"
    done
  ) &
  _DB_GH_PROXY_RENEW_PID=$!
}

stop_gh_proxy_capability_renewal() {
  local pid="${_DB_GH_PROXY_RENEW_PID:-}"
  [[ -n "$pid" ]] || return 0
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  unset _DB_GH_PROXY_RENEW_PID
}
# is *our* proxy answering on this port? (health endpoint, not just any listener)
proxy_health() { curl -fsS --max-time 1 "http://127.0.0.1:$1/_devbox" 2>/dev/null | grep -q 'devbox-ai-proxy'; }
# is anything at all listening on the port?
proxy_port_open() { timeout 1 bash -c ">/dev/tcp/127.0.0.1/$1" 2>/dev/null; }
# locate a proxy asset across source (../proxy) and brew (../libexec/proxy)
# layouts. This keeps the guest-side gh wrapper versioned with the host proxy.
proxy_asset() {
  local asset="$1" self dir c
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  dir="$(dirname "$self")"
  for c in "$dir/../proxy/$asset" "$dir/../libexec/proxy/$asset"; do
    [[ -f "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}
# locate the proxy launcher across source (../proxy) and brew (../libexec/proxy)
# layouts, falling back to a devbox-ai-proxy on PATH.
proxy_launcher() {
  local self dir c
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  dir="$(dirname "$self")"
  for c in "$dir/../proxy/run.sh" "$dir/../libexec/proxy/run.sh"; do
    [[ -f "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  command -v devbox-ai-proxy 2>/dev/null && return 0
  return 1
}
# start the host proxy if it isn't already up (idempotent). Shared across boxes.
proxy_ensure() {
  local url="$1" port launcher logf i
  port="$(proxy_port "$url")"
  if proxy_health "$port"; then log "credential proxy already running on 127.0.0.1:$port"; return 0; fi
  if proxy_port_open "$port"; then
    warn "port $port is held by another service (not devbox's proxy)."
    warn "  pick a free port: export DEVBOX_PROXY_URL=http://host.lima.internal:<PORT>"
    return 1
  fi
  launcher="$(proxy_launcher)" || { warn "proxy launcher not found — start it manually (devbox-ai-proxy)"; return 0; }
  mkdir -p "$CONFIG_DIR"; logf="$CONFIG_DIR/proxy.log"
  [[ -f "$CONFIG_DIR/api-keys.env" || -f "$CONFIG_DIR/proxy.config.json" || -f "$HOME/.claude/.credentials.json" ]] \
    || warn "no Anthropic key or host Claude login found — configure ~/.config/devbox/api-keys.env or run 'claude login'"
  log "Starting credential proxy on :$port  ($launcher)"
  setsid "$launcher" >"$logf" 2>&1 </dev/null &
  echo $! > "$CONFIG_DIR/proxy.pid"
  for i in $(seq 1 20); do proxy_health "$port" && break; sleep 0.2; done
  if proxy_health "$port"; then log "credential proxy up (pid $(cat "$CONFIG_DIR/proxy.pid" 2>/dev/null), log: $logf)"
  else warn "proxy did not come up — see $logf"; return 1; fi
}

apply_proxy() {
  local name="$1" url="$2" tmpl="$CONFIG_DIR/proxy-env" launcher gh_wrapper ca_path
  log "Wiring AI and GitHub CLIs → proxy $url"
  if [[ -f "$tmpl" ]]; then
    sed "s|__PROXY_URL__|$url|g" "$tmpl" \
      | limactl shell "$name" -- bash -c 'sudo tee /etc/profile.d/zz-devbox-10-proxy.sh >/dev/null'
  else
    limactl shell "$name" -- bash -c 'sudo tee /etc/profile.d/zz-devbox-10-proxy.sh >/dev/null' <<EOF
# devbox --proxy: keep real credentials on the host proxy.
export ANTHROPIC_BASE_URL="$url"
export ANTHROPIC_API_KEY="\${ANTHROPIC_API_KEY:-devbox-proxy}"
export OPENAI_BASE_URL="$url/v1"
export OPENAI_API_KEY="\${OPENAI_API_KEY:-devbox-proxy}"
EOF
  fi
  # Codex's ChatGPT subscription flow uses a different backend than the public
  # OpenAI API. Give it an isolated, devbox-owned config pointing at the host
  # proxy. The dummy API key above is only a routing marker; no OAuth material
  # is written to the guest.
  limactl shell "$name" -- bash -c 'sudo tee /etc/profile.d/zz-devbox-11-codex-proxy.sh >/dev/null' <<'EOF'
# devbox --proxy: keep Codex's isolated proxy profile separate from user config.
export CODEX_HOME="$HOME/.devbox/codex-proxy"
EOF
  # shellcheck disable=SC2016 # $HOME expands in the guest shell.
  limactl shell "$name" -- bash -c 'umask 077; install -d -m 700 "$HOME/.devbox/codex-proxy"'
  # shellcheck disable=SC2016 # $HOME expands in the guest shell.
  python3 - "$url/backend-api/codex" <<'PY' \
    | limactl shell "$name" -- bash -c 'tee "$HOME/.devbox/codex-proxy/config.toml" >/dev/null; chmod 600 "$HOME/.devbox/codex-proxy/config.toml"'
import json
import sys
print(f"openai_base_url = {json.dumps(sys.argv[1])}")
PY
  # shellcheck disable=SC2016 # $HOME expands in the guest shell.
  limactl shell "$name" -- bash -c 'rm -f "$HOME/.devbox/codex-proxy/auth.json"'

  # gh cannot choose a custom API base URL, so its wrapper uses an HTTPS CONNECT
  # proxy. It receives a dummy token only; the host proxy replaces that marker
  # after TLS termination with the token from the host's `gh auth login`.
  launcher="$(proxy_launcher)" || die "GitHub CLI proxy launcher not found"
  "$launcher" --init-gh-ca >/dev/null || die "could not initialise GitHub CLI proxy certificate"
  ca_path="$CONFIG_DIR/gh-proxy-ca.pem"
  [[ -r "$ca_path" ]] || die "GitHub CLI proxy CA was not created: $ca_path"
  gh_wrapper="$(proxy_asset gh-wrapper.py)" || die "GitHub CLI proxy wrapper not found"
  # shellcheck disable=SC2016 # $HOME expands inside the guest shell.
  limactl shell "$name" -- bash -c 'umask 077; install -d -m 700 "$HOME/.devbox/gh-proxy/bin" "$HOME/.devbox/gh-proxy/certs"'
  limactl copy "$gh_wrapper" "$name:.devbox/gh-proxy/bin/gh"
  limactl copy "$ca_path" "$name:.devbox/gh-proxy/certs/devbox-gh-proxy-ca.pem"
  # shellcheck disable=SC2016 # $HOME expands inside the guest shell.
  limactl shell "$name" -- bash -c 'chmod 755 "$HOME/.devbox/gh-proxy/bin/gh"; chmod 644 "$HOME/.devbox/gh-proxy/certs/devbox-gh-proxy-ca.pem"'
  renew_gh_proxy_capability "$name" "$url" || die "could not issue GitHub CLI proxy capability"
  limactl shell "$name" -- bash -c 'sudo tee /etc/profile.d/zz-devbox-12-gh-proxy.sh >/dev/null' <<EOF
# devbox --proxy: GitHub CLI uses a host-authenticated, GitHub-only TLS proxy.
# A function remains ahead of PATH even when a later user profile prepends
# Homebrew.  That happens in the stock golden, and otherwise leaves the real
# guest gh ahead of its Devbox proxy wrapper.
gh() {
  "\$HOME/.devbox/gh-proxy/bin/gh" "\$@"
}
export DEVBOX_GH_PROXY_URL_FILE="\$HOME/.devbox/gh-proxy/proxy-url"
export DEVBOX_GH_PROXY_CERT_DIR="\$HOME/.devbox/gh-proxy/certs"
EOF
  record_gh_proxy_endpoint "$name" "$url"
}

apply_api_keys() {
  local name="$1" file="$2"
  [[ -f "$file" ]] || { warn "api-keys file not found: $file (skipping)"; return 0; }
  log "Injecting API keys from $file"
  limactl shell "$name" -- bash -c 'sudo tee /etc/profile.d/zz-devbox-20-keys.sh >/dev/null' < "$file"
}

clear_auth() {
  local name="$1"
  log "Disabling devbox-managed auth in $name"
  clear_gh_proxy_endpoint "$name"
  # shellcheck disable=SC2016 # $HOME expands in the guest shell.
  limactl shell "$name" -- bash -c \
    'sudo rm -f /etc/profile.d/zz-devbox-10-proxy.sh /etc/profile.d/zz-devbox-11-codex-proxy.sh /etc/profile.d/zz-devbox-12-gh-proxy.sh /etc/profile.d/zz-devbox-20-keys.sh; rm -rf "$HOME/.devbox/codex-proxy" "$HOME/.devbox/gh-proxy"'
}

# ------------------------------------------------------- traffic audit egress ---
# `--traffic-audit=connect` is deliberately separate from `--proxy`: it grants
# a generic, short-lived CONNECT capability but never authenticates a provider.
# The guest firewall makes proxy-unaware apps fail instead of silently taking a
# direct HTTP(S) route. It is a workflow guard, not containment against code
# with guest root/sudo, which can change guest firewall rules.
ensure_guest_nftables() { # $1 Lima instance
  local name="$1"
  # shellcheck disable=SC2016 # Guest package-manager commands expand in the guest.
  limactl shell "$name" -- bash -lc '
    command -v nft >/dev/null 2>&1 && exit 0
    if command -v apt-get >/dev/null 2>&1; then
      sudo apt-get update
      sudo apt-get install -y --no-install-recommends nftables
    elif command -v dnf >/dev/null 2>&1; then
      sudo dnf install -y nftables
    elif command -v pacman >/dev/null 2>&1; then
      sudo pacman -Sy --noconfirm nftables
    else
      printf "%s\\n" "devbox traffic audit needs nftables in this guest" >&2
      exit 1
    fi
  '
}

traffic_proxy_endpoint_parts() { # $1 bare http proxy URL; print host<TAB>port
  python3 - "$1" <<'PY'
import sys
from urllib.parse import urlsplit

source = urlsplit(sys.argv[1])
if source.scheme != "http" or not source.hostname or source.username or source.password or source.path or source.query or source.fragment:
    raise SystemExit("traffic proxy URL must be a bare http://host:port URL")
print(f"{source.hostname}\t{source.port or 4141}")
PY
}

apply_connect_traffic_firewall() { # $1 Lima instance $2 proxy hostname $3 port
  local name="$1" proxy_host="$2" proxy_port="$3"
  if ! [[ "$proxy_port" =~ ^[1-9][0-9]{0,4}$ ]] || (( proxy_port > 65535 )); then
    die "invalid traffic proxy port: $proxy_port"
  fi
  # The proxy endpoint is the only direct web exception. Resolve its IPv4
  # address inside the guest so Lima's host DNS name works with all tools.
  limactl shell "$name" -- bash -s -- "$proxy_host" "$proxy_port" <<'EOF'
set -euo pipefail
proxy_host="$1"
proxy_port="$2"
proxy_ip="$(getent ahostsv4 "$proxy_host" | awk 'NR == 1 { print $1}')"
[[ "$proxy_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || {
  printf 'could not resolve an IPv4 address for Devbox traffic proxy %s\n' "$proxy_host" >&2
  exit 1
}
sudo nft delete table inet devbox_traffic_audit 2>/dev/null || true
sudo nft -f - <<RULES
table inet devbox_traffic_audit {
  chain output {
    type filter hook output priority 0; policy accept;
    ip daddr 127.0.0.0/8 accept
    ip6 daddr ::1 accept
    ip daddr $proxy_ip tcp dport $proxy_port accept
    tcp dport { 80, 443 } reject with tcp reset
    udp dport { 80, 443 } reject
  }
}
RULES
EOF
}

clear_connect_traffic_audit() { # $1 Lima instance
  local name="$1"
  log "Removing proxy-or-fail traffic audit from $name"
  clear_traffic_proxy_endpoint "$name"
  limactl shell "$name" -- bash -c \
    'sudo rm -f /etc/profile.d/zz-devbox-30-traffic-audit.sh; command -v nft >/dev/null 2>&1 && sudo nft delete table inet devbox_traffic_audit 2>/dev/null || true'
}

apply_connect_traffic_audit() { # $1 Lima instance $2 bare host proxy URL
  local name="$1" url="$2" launcher traffic_proxy_token traffic_url parts proxy_host proxy_port
  valid_gh_proxy_endpoint "$url" || die "traffic proxy URL must be a bare http://host:port URL"
  launcher="$(proxy_launcher)" || die "traffic proxy launcher not found"
  traffic_proxy_token="$("$launcher" --new-traffic-proxy-token)" || \
    die "could not issue traffic proxy capability"
  [[ "$traffic_proxy_token" == *.* ]] || die "traffic proxy returned an invalid capability"
  traffic_url="$(printf '%s' "$traffic_proxy_token" | traffic_proxy_url "$url")" || \
    die "could not configure traffic proxy URL"
  parts="$(traffic_proxy_endpoint_parts "$url")" || die "could not parse traffic proxy URL"
  IFS=$'\t' read -r proxy_host proxy_port <<< "$parts"

  log "Enabling proxy-or-fail web traffic audit in $name"
  ensure_guest_nftables "$name" || die "could not install nftables in $name"
  apply_connect_traffic_firewall "$name" "$proxy_host" "$proxy_port" || \
    die "could not block direct web egress in $name"
  # This is a short-lived network capability, not a host credential. It must
  # be readable by guest applications through their login-shell profile;
  # applications which ignore it still hit the direct-port firewall and fail.
  printf '%s' "$traffic_url" | python3 -c '
import shlex
import sys
url = sys.stdin.read().strip()
if not url:
    raise SystemExit("empty traffic proxy URL")
quoted = shlex.quote(url)
print("# devbox --traffic-audit=connect: route ordinary web tools through the audited")
print("# host CONNECT proxy. Direct TCP/UDP 80/443 is blocked by the guest nft table.")
for key in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy"):
    print(f"export {key}={quoted}")
print("unset NO_PROXY no_proxy")
' | limactl shell "$name" -- bash -c 'sudo tee /etc/profile.d/zz-devbox-30-traffic-audit.sh >/dev/null'
  record_traffic_proxy_endpoint "$name" "$url"
}

# ------------------------------------------------------------ GUI / Waypipe ---
host_wayland_socket() {
  local runtime="${XDG_RUNTIME_DIR:-}" display="${WAYLAND_DISPLAY:-}" socket
  [[ -n "$runtime" && -n "$display" ]] || \
    die "devbox gui needs a host Wayland session (WAYLAND_DISPLAY and XDG_RUNTIME_DIR are unset)"
  if [[ "$display" == /* ]]; then socket="$display"; else socket="$runtime/$display"; fi
  [[ -S "$socket" ]] || die "devbox gui cannot find the host Wayland socket: $socket"
}

lima_ssh_config() { # $1 Lima instance; print its SSH config path
  local name="$1" config
  config="$(limactl list --format '{{.Name}}|{{.SSHConfigFile}}' \
    | awk -F '|' -v name="$name" '$1 == name { print $2; exit }')"
  [[ -n "$config" && -r "$config" ]] || \
    die "could not find Lima SSH configuration for $name"
  printf '%s' "$config"
}

ensure_guest_waypipe() { # $1 Lima instance
  local name="$1"
  # shellcheck disable=SC2016 # Guest package-manager commands expand in the guest.
  limactl shell "$name" -- bash -lc '
    command -v waypipe >/dev/null 2>&1 && exit 0
    if command -v apt-get >/dev/null 2>&1; then
      sudo apt-get update
      sudo apt-get install -y --no-install-recommends waypipe
    elif command -v dnf >/dev/null 2>&1; then
      sudo dnf install -y waypipe
    elif command -v pacman >/dev/null 2>&1; then
      sudo pacman -Sy --noconfirm waypipe
    else
      printf "%s\\n" "devbox gui needs waypipe installed in this guest" >&2
      exit 1
    fi
  '
}

gui_remote_command() { # $1 guest workdir; remaining args are the guest app command
  python3 - "$@" <<'PY'
import shlex
import sys

directory, *command = sys.argv[1:]
if not command:
    raise SystemExit("missing GUI application command")
print("cd " + shlex.quote(directory) + " && exec " + " ".join(map(shlex.quote, command)))
PY
}

gui_remote_shell() { # $1 guest workdir
  python3 - "$1" <<'PY'
import shlex
import sys

print("cd " + shlex.quote(sys.argv[1]) + " && exec bash -l")
PY
}

require_host_gui() {
  command -v waypipe >/dev/null 2>&1 || \
    die "devbox gui needs host waypipe; install the distro package named 'waypipe'"
  host_wayland_socket
}

run_gui_remote() { # $1 Lima instance $2 remote bash command $3 shell|app
  local name="$1" remote_command="$2" kind="$3" ssh_config
  require_host_gui
  ensure_guest_waypipe "$name" || die "could not install waypipe in $name"
  ssh_config="$(lima_ssh_config "$name")"
  log "Opening $kind from $name on the host Wayland session"
  # QEMU guests do not have host DRM/render-node passthrough. Blocking DMABUF
  # protocols makes Waypipe use its safe, software-backed transport instead.
  waypipe --no-gpu --title-prefix 'Devbox: ' ssh -F "$ssh_config" "lima-$name" \
    bash -lc "$remote_command"
}

run_gui() { # $1 Lima instance $2 guest workdir; remaining args are the guest app command
  local name="$1" directory="$2" remote_command
  shift 2
  [[ $# -gt 0 ]] || die "usage: devbox gui [DIR] [FLAGS] [-- APP [ARGS...]]"
  remote_command="$(gui_remote_command "$directory" "$@")" || \
    die "could not prepare the guest GUI command"
  run_gui_remote "$name" "$remote_command" app
}

run_gui_shell() { # $1 Lima instance $2 guest workdir
  local name="$1" directory="$2" remote_command ssh_config
  require_host_gui
  ensure_guest_waypipe "$name" || die "could not install waypipe in $name"
  ssh_config="$(lima_ssh_config "$name")"
  remote_command="$(gui_remote_shell "$directory")" || \
    die "could not prepare the guest GUI shell"
  log "Opening GUI-ready shell from $name on the host Wayland session"
  # A pseudo-terminal makes the replacement login shell interactive while its
  # inherited Waypipe display lets every GUI app it launches reach the host.
  waypipe --no-gpu --title-prefix 'Devbox: ' ssh -F "$ssh_config" -tt "lima-$name" \
    bash -lc "$remote_command"
}

# PATH[:ro|:rw] -> a Lima --mount value (bare = read-only, :w suffix = writable).
_lima_mount_arg() {
  local spec="$1"
  case "$spec" in
    *:rw) printf '%s:w' "$(abspath "${spec%:rw}")";;
    *:ro) printf '%s'   "$(abspath "${spec%:ro}")";;
    *)    printf '%s'   "$(abspath "$spec")";;
  esac
}
# SRC[:DEST] split for --copy. No colon -> DEST is the basename (lands in $HOME).
_copy_src()  { local s="$1"; if [[ "$s" == *:* ]]; then printf '%s' "${s%:*}"; else printf '%s' "$s"; fi; }
_copy_dest() { local s="$1"; if [[ "$s" == *:* ]]; then printf '%s' "${s##*:}"; else basename -- "$s"; fi; }

apply_copy() {
  local name="$1" spec="$2" src dest parent rflag=()
  src="$(_copy_src "$spec")"; dest="$(_copy_dest "$spec")"
  [[ -e "$src" ]] || { warn "--copy source not found: $src"; return 0; }
  src="$(abspath "$src")"; parent="$(dirname "$dest")"
  [[ -d "$src" ]] && rflag=(-r)   # -r only for dirs; on a file it makes dest a dir
  log "Copying $src → $name:$dest"
  if [[ "$dest" == /* ]]; then
    limactl shell "$name" -- bash -c "sudo install -d -o \"\$(id -un)\" -g \"\$(id -gn)\" '$parent'" </dev/null 2>/dev/null || true
  else
    limactl shell "$name" -- bash -c "cd && mkdir -p '$parent'" </dev/null 2>/dev/null || true
  fi
  limactl copy "${rflag[@]}" "$src" "$name:$dest" 2>/dev/null || warn "copy failed: $src → $dest"
}

apply_creds() {
  local name="$1" p rel copied=0 rflag=()
  log "Copying host AI credentials into $name (best-effort)…"
  for p in "${CRED_PATHS[@]}"; do
    [[ -e "$p" ]] || continue
    case "$p" in "$HOME/"*) rel="${p#"$HOME"/}";; *) continue;; esac
    limactl shell "$name" -- bash -c "cd; mkdir -p '$(dirname "$rel")'" </dev/null 2>/dev/null || true
    # Lima's recursive mode makes a file destination into a directory.  The
    # credential list intentionally contains both files and directories.
    rflag=()
    [[ -d "$p" ]] && rflag=(-r)
    if limactl copy "${rflag[@]}" "$p" "$name:$rel" 2>/dev/null; then copied=$((copied+1)); else warn "could not copy $p"; fi
  done
  log "Copied $copied credential path(s)."
}

agent_config_files() { # paths -> NUL-delimited regular files
  local path
  for path in "$@"; do
    if [[ -f "$path" ]]; then
      printf '%s\0' "$path"
    elif [[ -d "$path" ]]; then
      # A user may keep an allowlisted config directory (notably
      # ~/.claude/hooks) in a separate, versioned vault.  Follow only the
      # path supplied by the allowlist; links encountered beneath it remain
      # untouched, so a config tree cannot pull arbitrary host files in.
      find -H "$path" -type f -print0
    fi
  done
}

agent_config_contains_credential() { # $1 config file; never prints its content
  local file="$1"
  local field_assignment="((access|refresh|id)[_-]?token|api[_-]?key|authorization|password|secret|credential)[[:space:]]*[\\\"']?[[:space:]]*[:=][[:space:]]*[\\\"']?[^\\\"'[:space:]]+"
  # An empty instruction/config file is harmless. `grep -q ''` reports no
  # match for it, so avoid mistaking it for binary input.
  [[ -s "$file" ]] || return 1
  # Config is text. Treat binary input as unsafe rather than copying it.
  LC_ALL=C grep -Iq '' "$file" || return 0
  # Require an assigned value to avoid rejecting harmless prose such as
  # "do not commit API keys". Prefixes cover opaque keys whose field name is
  # not recognisable. This is a defense in depth layer after the allowlist.
  LC_ALL=C grep -IEq "$field_assignment|(sk-(proj-|ant-)?|rk-live-|sess-)[A-Za-z0-9_-]{16,}|eyJ[A-Za-z0-9_-]{12,}\\.[A-Za-z0-9_-]{12,}\\.[A-Za-z0-9_-]{8,}" "$file"
}

apply_agent_config() {
  local name="$1" file rel parent copied=0 skipped=0
  log "Copying non-secret host AI agent configuration into $name…"
  while IFS= read -r -d '' file; do
    case "$file" in "$HOME/"*) rel="${file#"$HOME"/}";; *) continue;; esac
    if agent_config_contains_credential "$file"; then
      warn "skipping possible credential in agent config: $rel"
      skipped=$((skipped+1))
      continue
    fi
    parent="$(dirname "$rel")"
    limactl shell "$name" -- bash -c "cd; mkdir -p '$parent'" </dev/null 2>/dev/null || true
    if limactl copy "$file" "$name:$rel" 2>/dev/null; then
      copied=$((copied+1))
    else
      warn "could not copy agent config: $rel"
    fi
  done < <(agent_config_files "${AGENT_CONFIG_PATHS[@]}")
  log "Copied $copied non-secret agent config file(s); skipped $skipped possible credential(s)."
}

apply_session_persistence() { # $1 instance $2 mounted per-project host directory
  local name="$1" state="$2"
  log "Linking resumable AI sessions to host state: $state"

  # OpenCode keeps current session records in one SQLite database. Point only
  # that database at persistent state; auth.json and the rest of its data home
  # remain on the disposable guest disk.
  python3 - "$state" <<'PY' \
    | limactl shell "$name" -- bash -c 'sudo tee /etc/profile.d/zz-devbox-08-session-persistence.sh >/dev/null; sudo chmod 644 /etc/profile.d/zz-devbox-08-session-persistence.sh'
import shlex
import sys

root = sys.argv[1]
print("# devbox: per-project resumable agent sessions; no credential homes")
print(f"export DEVBOX_AI_SESSION_DIR={shlex.quote(root)}")
print(f"export OPENCODE_DB={shlex.quote(root + '/opencode/opencode.db')}")
PY

  # Migrate session material already present in a kept VM on first use, then
  # replace only known session paths with links into the mounted state root.
  # Unknown/custom links are deliberately left alone.
  limactl shell "$name" -- bash -s -- "$state" <<'GUEST'
set -euo pipefail
state="$1"
umask 077
mkdir -p "$state" "$state/claude" "$state/codex" "$state/opencode" \
  "$state/pi" "$state/stado"
chmod 700 "$state" "$state/claude" "$state/codex" "$state/opencode" \
  "$state/pi" "$state/stado"

link_dir() { # $1 guest path $2 path relative to state root
  src="$1"; dst="$state/$2"
  mkdir -p "$(dirname "$src")" "$(dirname "$dst")" "$dst"
  chmod 700 "$dst"
  if [ -L "$src" ]; then
    current="$(readlink -f "$src" 2>/dev/null || true)"
    if [ "$current" = "$dst" ]; then return 0; fi
    printf '[devbox] WARN: preserving custom session link: %s\n' "$src" >&2
    return 0
  fi
  if [ -e "$src" ]; then
    if [ ! -d "$src" ]; then
      printf '[devbox] WARN: expected a session directory, preserving: %s\n' "$src" >&2
      return 0
    fi
    cp -au "$src/." "$dst/"
    rm -rf -- "$src"
  fi
  ln -s "$dst" "$src"
}

link_append_file() { # append-only history/index file
  src="$1"; dst="$state/$2"
  mkdir -p "$(dirname "$src")" "$(dirname "$dst")"
  if [ -L "$src" ]; then
    current="$(readlink -f "$src" 2>/dev/null || true)"
    if [ "$current" = "$dst" ]; then return 0; fi
    printf '[devbox] WARN: preserving custom session link: %s\n' "$src" >&2
    return 0
  fi
  if [ -e "$src" ]; then
    if [ ! -f "$src" ]; then
      printf '[devbox] WARN: expected a session index file, preserving: %s\n' "$src" >&2
      return 0
    fi
    touch "$dst"
    cat "$src" >> "$dst"
    rm -f -- "$src"
  else
    touch "$dst"
  fi
  chmod 600 "$dst"
  ln -s "$dst" "$src"
}

# Claude Code: transcripts plus the session-bound shell/file restore material.
link_dir "$HOME/.claude/projects"        "claude/projects"
link_dir "$HOME/.claude/sessions"        "claude/sessions"
link_dir "$HOME/.claude/file-history"    "claude/file-history"
link_dir "$HOME/.claude/session-env"     "claude/session-env"
link_dir "$HOME/.claude/shell-snapshots" "claude/shell-snapshots"
link_append_file "$HOME/.claude/history.jsonl" "claude/history.jsonl"

# Codex uses a separate CODEX_HOME while --proxy is active. Both profiles share
# the project transcript/index store, so changing auth mode does not hide chats.
for codex_home in "$HOME/.codex"; do
  link_dir "$codex_home/sessions"          "codex/sessions"
  link_dir "$codex_home/archived_sessions" "codex/archived_sessions"
  link_dir "$codex_home/shell_snapshots"   "codex/shell-snapshots"
  link_append_file "$codex_home/session_index.jsonl" "codex/session_index.jsonl"
done
if [ -f /etc/profile.d/zz-devbox-11-codex-proxy.sh ]; then
  codex_home="$HOME/.devbox/codex-proxy"
  link_dir "$codex_home/sessions"          "codex/sessions"
  link_dir "$codex_home/archived_sessions" "codex/archived_sessions"
  link_dir "$codex_home/shell_snapshots"   "codex/shell-snapshots"
  link_append_file "$codex_home/session_index.jsonl" "codex/session_index.jsonl"
fi

# Pi stores one JSONL session tree per working directory.
link_dir "$HOME/.pi/agent/sessions" "pi/sessions"

# Preserve OpenCode's legacy JSON store and session attachments alongside the
# current database configured above. If upgrading a kept VM, move its current
# database only when no persistent database exists yet; SQLite DBs are never
# merged or overwritten.
link_dir "$HOME/.local/share/opencode/storage"     "opencode/storage"
link_dir "$HOME/.local/share/opencode/project"     "opencode/project"
link_dir "$HOME/.local/share/opencode/snapshot"    "opencode/snapshot"
link_dir "$HOME/.local/share/opencode/tool-output" "opencode/tool-output"
oc_src="$HOME/.local/share/opencode/opencode.db"
oc_dst="$state/opencode/opencode.db"
if [ -f "$oc_src" ] && [ ! -e "$oc_dst" ]; then
  mv "$oc_src" "$oc_dst"
  for suffix in -wal -shm; do
    [ ! -e "$oc_src$suffix" ] || mv "$oc_src$suffix" "$oc_dst$suffix"
  done
elif [ -f "$oc_src" ] && [ -e "$oc_dst" ]; then
  conflict="$state/opencode/kept-box-conflict-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$conflict"
  mv "$oc_src" "$conflict/opencode.db"
  for suffix in -wal -shm; do
    [ ! -e "$oc_src$suffix" ] || mv "$oc_src$suffix" "$conflict/opencode.db$suffix"
  done
  printf '[devbox] WARN: preserved conflicting kept-box OpenCode DB at %s\n' "$conflict" >&2
fi

# Stado keeps transcripts and persistent worktrees outside its credential and
# plugin directories. Its Git refs remain in the already-mounted project.
link_dir "$HOME/.local/share/stado/sessions" "stado/sessions"
link_dir "$HOME/.local/state/stado/worktrees" "stado/worktrees"
GUEST
}

disable_session_persistence() { # $1 instance $2 state path previously used by this project
  local name="$1" state="$2"
  log "Using ephemeral AI sessions in $name"
  limactl shell "$name" -- bash -s -- "$state" <<'GUEST'
set -euo pipefail
state="$1"
sudo rm -f /etc/profile.d/zz-devbox-08-session-persistence.sh
for path in \
  "$HOME/.claude/projects" "$HOME/.claude/sessions" \
  "$HOME/.claude/file-history" "$HOME/.claude/session-env" \
  "$HOME/.claude/shell-snapshots" \
  "$HOME/.codex/sessions" "$HOME/.codex/archived_sessions" \
  "$HOME/.codex/shell_snapshots" \
  "$HOME/.devbox/codex-proxy/sessions" \
  "$HOME/.devbox/codex-proxy/archived_sessions" \
  "$HOME/.devbox/codex-proxy/shell_snapshots" \
  "$HOME/.pi/agent/sessions" \
  "$HOME/.local/share/opencode/storage" \
  "$HOME/.local/share/opencode/project" \
  "$HOME/.local/share/opencode/snapshot" \
  "$HOME/.local/share/opencode/tool-output" \
  "$HOME/.local/share/stado/sessions" "$HOME/.local/state/stado/worktrees"; do
  if [ -L "$path" ]; then
    target="$(readlink "$path" 2>/dev/null || true)"
    case "$target" in "$state"/*) rm -f -- "$path"; mkdir -p "$path";; esac
  fi
done
for path in "$HOME/.claude/history.jsonl" \
  "$HOME/.codex/session_index.jsonl" \
  "$HOME/.devbox/codex-proxy/session_index.jsonl"; do
  if [ -L "$path" ]; then
    target="$(readlink "$path" 2>/dev/null || true)"
    case "$target" in "$state"/*) rm -f -- "$path";; esac
  fi
done
GUEST
}

# --------------------------------------------------------- project manifest --
project_manifest() { # $1 .devbox.toml -> normalized JSON
  python3 - "$1" <<'PY'
import json
import re
import sys
from pathlib import Path

try:
    import tomllib
except ImportError:
    raise SystemExit("Python 3.11+ is required to read .devbox.toml")

path = Path(sys.argv[1])
try:
    data = tomllib.loads(path.read_text())
except (OSError, tomllib.TOMLDecodeError) as exc:
    raise SystemExit(f"could not read {path}: {exc}")

allowed = {
    "image", "packages", "start", "ssh_agent", "keep", "proxy", "api_keys",
    "with_creds", "with_agent_config", "no_auth", "mounts", "copies", "resources",
}
unknown = sorted(set(data) - allowed)
if unknown:
    raise SystemExit(f"unknown .devbox.toml key(s): {', '.join(unknown)}")

# `image` is either the shorthand string form (image = "ubuntu-24.04") or the
# table form, which additionally carries the digest and the provisioning baked
# into this project's golden. TOML forbids both spellings in one file, so the
# value's type tells us which was used.
image_digest = image_provision = image_provision_user = ""
image = data.get("image")
if isinstance(image, dict):
    image_allowed = {"location", "digest", "provision", "provision_user"}
    unknown = sorted(set(image) - image_allowed)
    if unknown:
        raise SystemExit(f"unknown key(s) in [image]: {', '.join(unknown)}")
    for key in image_allowed:
        value = image.get(key)
        if value is not None and (not isinstance(value, str) or not value):
            raise SystemExit(f"image.{key} must be a non-empty string")
    location = image.get("location")
    if location is None:
        raise SystemExit("[image] requires a location")
    image_digest = image.get("digest") or ""
    image_provision = image.get("provision") or ""
    image_provision_user = image.get("provision_user") or ""
    image = location
elif image is not None and (not isinstance(image, str) or not image):
    raise SystemExit("image must be a non-empty string or an [image] table")

resources = data.get("resources", {})
if not isinstance(resources, dict):
    raise SystemExit("resources must be a table")
unknown = sorted(set(resources) - {"cpus", "memory", "disk"})
if unknown:
    raise SystemExit(f"unknown key(s) in [resources]: {', '.join(unknown)}")
cpus = resources.get("cpus")
if cpus is not None and (not isinstance(cpus, int) or isinstance(cpus, bool) or cpus < 1):
    raise SystemExit("resources.cpus must be a positive integer")
for key in ("memory", "disk"):
    value = resources.get(key)
    if value is None:
        continue
    if not isinstance(value, str) or not re.fullmatch(
            r"\d+(?:\.\d+)?\s*(?:[KMGT]iB|[KMGT]B|B)?", value, re.I):
        raise SystemExit(f"resources.{key} must be a size like \"8GiB\", \"512MiB\", or \"80\"")

packages = data.get("packages", [])
if not isinstance(packages, list) or any(not isinstance(p, str) or not p for p in packages):
    raise SystemExit("packages must be an array of non-empty Homebrew formula names")

start = data.get("start")
if start is not None and (not isinstance(start, str) or not start):
    raise SystemExit("start must be a non-empty shell command string")

for key in ("ssh_agent", "keep", "with_creds", "with_agent_config", "no_auth"):
    if key in data and not isinstance(data[key], bool):
        raise SystemExit(f"{key} must be true or false")

for key in ("proxy", "api_keys"):
    value = data.get(key, False)
    if not isinstance(value, (bool, str)) or isinstance(value, str) and not value:
        raise SystemExit(f"{key} must be true, false, or a non-empty path/URL string")

for key in ("mounts", "copies"):
    value = data.get(key, [])
    if not isinstance(value, list) or any(not isinstance(item, str) or not item for item in value):
        raise SystemExit(f"{key} must be an array of non-empty strings")

if data.get("no_auth") and (data.get("proxy") or data.get("api_keys") or data.get("with_creds")):
    raise SystemExit("no_auth cannot be combined with proxy, api_keys, or with_creds")

print(json.dumps({
    "image": image or "", "packages": packages, "start": start or "",
    "image_digest": image_digest,
    "image_provision": image_provision,
    "image_provision_user": image_provision_user,
    "cpus": cpus or "", "memory": resources.get("memory", ""),
    "disk": resources.get("disk", ""),
    "ssh_agent": data.get("ssh_agent", False), "keep": data.get("keep", False),
    "proxy": data.get("proxy", False), "api_keys": data.get("api_keys", False),
    "with_creds": data.get("with_creds", False),
    "with_agent_config": data.get("with_agent_config", False),
    "no_auth": data.get("no_auth", False),
    "mounts": data.get("mounts", []), "copies": data.get("copies", []),
}))
PY
}

manifest_value() { # $1 normalized manifest JSON $2 key
  python3 -c 'import json, sys; print(json.load(sys.stdin)[sys.argv[1]])' "$2" <<< "$1"
}

manifest_json_value() { # $1 normalized manifest JSON $2 key
  python3 -c 'import json, sys; print(json.dumps(json.load(sys.stdin)[sys.argv[1]]))' "$2" <<< "$1"
}

manifest_package_lines() { # $1 normalized package JSON -> one package per line
  python3 -c 'import json, sys; print(*json.load(sys.stdin), sep="\n")' <<< "$1"
}

apply_project_packages() { # $1 box name $2 normalized packages JSON
  local name="$1" packages="$2"
  [[ "$packages" != "[]" ]] || return 0
  log "Installing project packages from $PROJECT_MANIFEST_NAME"
  # shellcheck disable=SC2016 # the guest shell consumes package names on stdin.
  manifest_package_lines "$packages" | limactl shell "$name" -- bash -lc '
    while IFS= read -r package; do
      brew list --versions "$package" >/dev/null 2>&1 || brew install "$package"
    done
  '
}

run_project_start() { # $1 box name $2 workdir $3 command
  local name="$1" dir="$2" command="$3"
  [[ -n "$command" ]] || return 0
  log "Running $PROJECT_MANIFEST_NAME start command"
  limactl shell --workdir "$dir" "$name" -- bash -lc "$command" </dev/null \
    || warn "$PROJECT_MANIFEST_NAME start command exited non-zero"
}

confirm_manifest_permissions() { # each argument is one requested capability
  local request answer
  [[ $# -gt 0 ]] || return 0
  printf '%s\n' "This devbox wants to:" >&2
  for request in "$@"; do printf '%s\n' "- $request" >&2; done
  printf '%s' 'Do you agree? [y/N] ' >&2
  if [[ -t 0 ]]; then
    read -r answer
  elif [[ -r /dev/tty ]]; then
    read -r answer </dev/tty
  else
    die "$PROJECT_MANIFEST_NAME requests host access, but no terminal is available to approve it"
  fi
  [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]] || die "declined $PROJECT_MANIFEST_NAME host-access request"
}

# --------------------------------------------------------------- subcommands --
cmd_build() {
  local image="" force=0 assume_yes=0 manifest_path="" cli_cpus="" cli_memory="" cli_disk=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --image|-i) shift; image="${1:?--image needs a value}";;
      --image=*|-i=*) image="${1#*=}";;
      --manifest) shift; manifest_path="${1:?--manifest needs a path}";;
      --manifest=*) manifest_path="${1#*=}";;
      --cpus|-j) shift; cli_cpus="${1:?--cpus needs a value}";;
      --cpus=*|-j=*) cli_cpus="${1#*=}";;
      --memory|-M) shift; cli_memory="${1:?--memory needs a value}";;
      --memory=*|-M=*) cli_memory="${1#*=}";;
      --disk|-D) shift; cli_disk="${1:?--disk needs a value}";;
      --disk=*|-D=*) cli_disk="${1#*=}";;
      --force|-f) force=1;;
      --yes|-y) assume_yes=1;;
      -h|--help) grep -E '^#( |$)' "$0" | sed -E 's/^# ?//'; return 0;;
      *) die "build: unknown arg: $1";;
    esac; shift
  done

  # A golden's contents are defined by the project manifest, so `devbox build`
  # in a project directory builds that project's golden. An explicit --image
  # still wins, but the manifest's provisioning continues to apply.
  [[ -n "$manifest_path" || ! -f "$PWD/$PROJECT_MANIFEST_NAME" ]] \
    || manifest_path="$PWD/$PROJECT_MANIFEST_NAME"
  local manifest='{}' digest="" provision="" provision_user=""
  if [[ -n "$manifest_path" && -f "$manifest_path" ]]; then
    manifest="$(project_manifest "$manifest_path")" || die "invalid $manifest_path"
    [[ -n "$image" ]] || image="$(manifest_value "$manifest" image)"
    digest="$(manifest_value "$manifest" image_digest)"
    provision="$(manifest_value "$manifest" image_provision)"
    provision_user="$(manifest_value "$manifest" image_provision_user)"
    # Baking a repo-controlled script into a persistent golden needs the same
    # consent as running one. cmd_run has already asked by the time it delegates
    # here, so only a direct `devbox build` prompts.
    if [[ -n "$provision$provision_user" && $assume_yes -eq 0 && "${_DB_MANIFEST_CONFIRMED:-0}" -ne 1 ]]; then
      confirm_manifest_permissions "build a custom golden image with provisioning from $manifest_path"
    fi
  fi
  [[ -n "$image" ]] || image="$DEFAULT_IMAGE"

  local cpus memory disk
  IFS=$'\t' read -r cpus memory disk < <(resolve_resources \
    "$cli_cpus" "$cli_memory" "$cli_disk" "$manifest" "$(global_config_json)")
  size_to_gib "$memory" >/dev/null || die "invalid memory size: $memory"
  size_to_gib "$disk"   >/dev/null || die "invalid disk size: $disk"

  local hash golden gy
  hash="$(golden_spec_hash "$image" "$digest" "$provision" "$provision_user")"
  golden="$(golden_name "$image" "$hash")"; gy="$CONFIG_DIR/${golden}.yaml"
  mkdir -p "$CONFIG_DIR"
  emit_golden_yaml "$image" "$gy" "$cpus" "$memory" "$disk" \
    "$digest" "$provision" "$provision_user"
  if instance_exists "$golden"; then
    if [[ $force -eq 1 ]]; then
      log "Rebuilding golden $golden…"
      limactl stop -f "$golden" 2>/dev/null || true; limactl delete -f "$golden"
    else
      log "Golden $golden already exists (use 'devbox build --image $image --force' to rebuild)."
      return 0
    fi
  fi
  log "Building golden $golden from image '$image' — this takes several minutes…"
  limactl start --timeout "$DEFAULT_BUILD_TIMEOUT" --name="$golden" "$gy"
  apply_golden_provisioning "$golden" "$provision" "$provision_user"
  log "Verifying toolchain in $golden:"
  if ! verify_golden "$golden"; then
    warn "Golden verification failed; removing unusable $golden."
    limactl stop -f "$golden" 2>/dev/null || true
    limactl delete -f "$golden" 2>/dev/null || true
    return 1
  fi
  log "Stopping golden (retained as clone source)."
  limactl stop "$golden"
  log "Golden ready: $golden"
}

# Teardown runs from an EXIT/INT/TERM trap, which fires after cmd_run has
# returned — so its state must be global, not cmd_run locals (those are gone by
# then, and would trip `set -u`). A prior process may have left a box behind,
# but the disposable default still applies when this invocation exits.
run_cleanup() {
  local rc=$?
  trap - EXIT INT TERM
  stop_gh_proxy_capability_renewal
  if [[ "${_DB_KEEP:-0}" -eq 1 ]]; then
    log "--keep: retained ${_DB_NAME:-?}"
    log "  re-enter: devbox $(printf '%q' "${_DB_DIR:-.}")$([[ "${_DB_IMAGE:-}" != "$DEFAULT_IMAGE" ]] && printf ' --image %q' "${_DB_IMAGE:-}")"
    log "  destroy:  devbox destroy ${_DB_NAME:-?}"
  elif [[ -n "${_DB_NAME:-}" ]]; then
    log "Destroying ${_DB_NAME}…"
    limactl stop -f "$_DB_NAME" 2>/dev/null || true
    limactl delete -f "$_DB_NAME" 2>/dev/null || true
    clear_gh_proxy_endpoint "$_DB_NAME"
    clear_traffic_proxy_endpoint "$_DB_NAME"
  fi
  if [[ -n "${_DB_SESSION_DIR:-}" ]]; then
    log "AI sessions retained: ${_DB_SESSION_DIR}"
    log "  resume from the same project with the agent's native resume command"
  fi
  exit "$rc"
}

cmd_run() {
  local dir="" image="$DEFAULT_IMAGE" image_set=0 keep=0 with_creds=0 with_agent_config=0 api_keys="" proxy="" no_auth=0 ssh_agent=0 name="" gui=0 traffic_audit="" ephemeral_sessions=0
  local extra_mounts=() extra_copies=() manifest_requests=() gui_command=()
  local cli_cpus="" cli_memory="" cli_disk=""
  local golden_digest="" golden_provision="" golden_provision_user=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --image|-i) shift; image="${1:?--image needs a value}"; image_set=1;;
      --image=*|-i=*) image="${1#*=}"; image_set=1;;
      --cpus|-j) shift; cli_cpus="${1:?--cpus needs a value}";;
      --cpus=*|-j=*) cli_cpus="${1#*=}";;
      --memory|-M) shift; cli_memory="${1:?--memory needs a value}";;
      --memory=*|-M=*) cli_memory="${1#*=}";;
      --disk|-D) shift; cli_disk="${1:?--disk needs a value}";;
      --disk=*|-D=*) cli_disk="${1#*=}";;
      --keep|-k) keep=1;;
      --ephemeral-sessions|-e) ephemeral_sessions=1;;
      --ssh-agent|-s) ssh_agent=1;;
      --with-creds|-c) with_creds=1;;
      --with-agent-config|-g) with_agent_config=1;;
      -a) with_agent_config=1; proxy="$PROXY_DEFAULT_URL"; ssh_agent=1;;
      --no-auth|-n) no_auth=1;;
      --api-keys|-K) api_keys="$DEFAULT_KEYS_FILE";;
      --api-keys=*|-K=*) api_keys="$(abspath "${1#*=}")";;
      --proxy|-p) proxy="$PROXY_DEFAULT_URL";;
      --proxy=*|-p=*) proxy="${1#*=}";;
      --traffic-audit|-T) traffic_audit=connect;;
      --traffic-audit=*|-T=*) traffic_audit="${1#*=}";;
      --mount|-m) shift; extra_mounts+=("${1:?--mount needs PATH[:ro|:rw]}");;
      --mount=*|-m=*) extra_mounts+=("${1#*=}");;
      --copy|-C) shift; extra_copies+=("${1:?--copy needs SRC[:DEST]}");;
      --copy=*|-C=*) extra_copies+=("${1#*=}");;
      --name|-N) shift; name="${1:?--name needs a value}";;
      --name=*|-N=*) name="${1#*=}";;
      --gui|-G) gui=1;;
      --) shift; gui_command=("$@"); break;;
      -h|--help) grep -E '^#( |$)' "$0" | sed -E 's/^# ?//'; return 0;;
      -*) die "unknown flag: $1 (see: devbox --help)";;
      *) dir="$1";;
    esac; shift
  done
  [[ $gui -eq 1 || ${#gui_command[@]} -eq 0 ]] || \
    die "-- is only valid with devbox gui"
  case "$traffic_audit" in
    ""|connect|off) ;;
    *) die "--traffic-audit accepts connect or off";;
  esac
  dir="$(abspath "${dir:-$PWD}")"
  [[ -d "$dir" ]] || die "not a directory: $dir"
  [[ $gui -eq 0 ]] || require_host_gui

  local manifest_path="$dir/$PROJECT_MANIFEST_NAME" manifest="" manifest_start=""
  if [[ -f "$manifest_path" ]]; then
    manifest="$(project_manifest "$manifest_path")" || die "invalid $PROJECT_MANIFEST_NAME"
    local manifest_image manifest_proxy manifest_api_keys manifest_mounts manifest_copies item
    manifest_image="$(manifest_value "$manifest" image)"
    [[ $image_set -eq 1 || -z "$manifest_image" ]] || image="$manifest_image"
    golden_digest="$(manifest_value "$manifest" image_digest)"
    golden_provision="$(manifest_value "$manifest" image_provision)"
    golden_provision_user="$(manifest_value "$manifest" image_provision_user)"
    # Provisioning from a repo-controlled file is arbitrary root code inside the
    # VM, and it is baked into a golden that outlives this run — so it is its own
    # approval line, not folded into the `start` command's.
    if [[ -n "$golden_provision$golden_provision_user" ]]; then
      manifest_requests+=("build a custom golden image with project-supplied provisioning")
    fi
    # Resources are host-affecting: a manifest can ask for the host's RAM.
    if [[ -n "$(manifest_value "$manifest" cpus)$(manifest_value "$manifest" memory)$(manifest_value "$manifest" disk)" ]]; then
      manifest_requests+=("size the box using the manifest's [resources]")
    fi
    manifest_start="$(manifest_value "$manifest" start)"
    [[ -z "$manifest_start" ]] || manifest_requests+=("run startup command: $(printf '%q' "$manifest_start")")

    if [[ "$(manifest_value "$manifest" ssh_agent)" == True && $ssh_agent -eq 0 ]]; then
      ssh_agent=1
      manifest_requests+=("enable SSH agent forwarding")
    fi
    if [[ "$(manifest_value "$manifest" keep)" == True ]]; then
      keep=1
      manifest_requests+=("keep the devbox after exit")
    fi

    if [[ "$(manifest_value "$manifest" with_agent_config)" == True && $with_agent_config -eq 0 ]]; then
      with_agent_config=1
      manifest_requests+=("copy non-secret AI agent configuration into the devbox")
    fi
    if [[ $no_auth -eq 0 ]]; then
      manifest_proxy="$(manifest_value "$manifest" proxy)"
      if [[ -z "$proxy" && "$manifest_proxy" != False ]]; then
        if [[ "$manifest_proxy" == True ]]; then proxy="$PROXY_DEFAULT_URL"; else proxy="$manifest_proxy"; fi
        manifest_requests+=("enable the AI authentication proxy")
      fi
      manifest_api_keys="$(manifest_value "$manifest" api_keys)"
      if [[ -z "$api_keys" && "$manifest_api_keys" != False ]]; then
        if [[ "$manifest_api_keys" == True ]]; then api_keys="$DEFAULT_KEYS_FILE"; else api_keys="$(abspath "$manifest_api_keys")"; fi
        manifest_requests+=("copy API keys into the devbox")
      fi
      if [[ "$(manifest_value "$manifest" with_creds)" == True && $with_creds -eq 0 ]]; then
        with_creds=1
        manifest_requests+=("copy AI credentials into the devbox")
      fi
    fi
    if [[ "$(manifest_value "$manifest" no_auth)" == True && $no_auth -eq 0 ]]; then
      no_auth=1
    fi

    manifest_mounts="$(manifest_json_value "$manifest" mounts)"
    while IFS= read -r item; do
      [[ -n "$item" ]] || continue
      extra_mounts+=("$item")
      case "$item" in
        *:rw) manifest_requests+=("mount ${item%:rw} read-write at ${item%:rw}");;
        *:ro) manifest_requests+=("mount ${item%:ro} read-only at ${item%:ro}");;
        *)    manifest_requests+=("mount $item read-only at $item");;
      esac
    done < <(python3 -c 'import json, sys; print(*json.load(sys.stdin), sep="\n")' <<< "$manifest_mounts")
    manifest_copies="$(manifest_json_value "$manifest" copies)"
    while IFS= read -r item; do
      [[ -n "$item" ]] || continue
      extra_copies+=("$item")
      manifest_requests+=("copy $(_copy_src "$item") to $(_copy_dest "$item")")
    done < <(python3 -c 'import json, sys; print(*json.load(sys.stdin), sep="\n")' <<< "$manifest_copies")
  fi
  if [[ $no_auth -eq 1 && ( -n "$proxy" || -n "$api_keys" || $with_creds -eq 1 ) ]]; then
    die "--no-auth cannot be combined with --proxy, --api-keys, or --with-creds"
  fi
  confirm_manifest_permissions "${manifest_requests[@]}"
  _DB_MANIFEST_CONFIRMED=1   # do not re-prompt when cmd_build is delegated to below
  [[ $ssh_agent -eq 1 ]] && require_ssh_agent

  local cpus memory disk
  IFS=$'\t' read -r cpus memory disk < <(resolve_resources \
    "$cli_cpus" "$cli_memory" "$cli_disk" "${manifest:-{\}}" "$(global_config_json)")
  size_to_gib "$memory" >/dev/null || die "invalid memory size: $memory"
  size_to_gib "$disk"   >/dev/null || die "invalid disk size: $disk"

  local golden golden_hash
  golden_hash="$(golden_spec_hash "$image" "$golden_digest" "$golden_provision" "$golden_provision_user")"
  golden="$(golden_name "$image" "$golden_hash")"
  [[ -n "$name" ]] || name="$(instance_name "$image" "$dir")"
  local session_state session_owner=""
  session_state="$(project_session_dir "$dir")"
  if [[ $ephemeral_sessions -eq 0 ]]; then
    prepare_session_dir "$session_state"
    session_owner="$(session_state_other_instance "$session_state" "$name")"
    [[ -z "$session_owner" ]] || \
      die "AI session state is already attached to $session_owner; destroy it or use --ephemeral-sessions"
  fi

  local preexisting=0
  if instance_exists "$name"; then
    preexisting=1
    log "Attaching to existing box for this path: $name"
    [[ ${#extra_mounts[@]} -gt 0 ]] && warn "--mount only applies at box creation; destroy+recreate to change mounts (--copy still works)"
  else
    if ! instance_exists "$golden"; then
      log "No golden for image '$image' yet — building it first."
      local build_args=(--image "$image" --cpus "$cpus" --memory "$memory" --disk "$disk")
      [[ -f "$manifest_path" ]] && build_args+=(--manifest "$manifest_path")
      cmd_build "${build_args[@]}"
    fi
    ensure_golden_stopped "$golden"
    local clone_args=(--mount "${dir}:w") m
    [[ $ephemeral_sessions -eq 1 ]] || clone_args+=(--mount "${session_state}:w")
    for m in "${extra_mounts[@]}"; do clone_args+=(--mount "$(_lima_mount_arg "$m")"); done
    # CPU/memory are per-box: applied to the clone so a project can be sized
    # without rebuilding the shared golden.
    clone_args+=(--cpus "$cpus" --memory "$(size_to_gib "$memory")")
    # Disk is grow-only — qcow2 cannot shrink — so a smaller request is refused
    # loudly here rather than failing deep inside Lima.
    local want_disk golden_disk
    want_disk="$(size_to_gib "$disk")"
    golden_disk="$(limactl list "$golden" --format '{{.Disk}}' 2>/dev/null || echo 0)"
    golden_disk="$(python3 -c 'import sys; print(int(sys.argv[1])/1024**3)' "${golden_disk:-0}")"
    if python3 -c 'import sys; sys.exit(0 if float(sys.argv[1]) > float(sys.argv[2]) else 1)' \
         "$want_disk" "$golden_disk"; then
      clone_args+=(--disk "$want_disk")
    elif python3 -c 'import sys; sys.exit(0 if float(sys.argv[1]) < float(sys.argv[2]) else 1)' \
         "$want_disk" "$golden_disk"; then
      warn "requested disk ${disk} is smaller than the golden's ${golden_disk}GiB; qcow2 cannot shrink — keeping ${golden_disk}GiB"
    fi
    # `limactl clone --set` applies this to the stopped destination config, so
    # the very first boot already has the agent socket. Existing VMs still use
    # enable_ssh_agent below and restart only if their persisted config changes.
    [[ $ssh_agent -eq 1 ]] && clone_args+=(--set '.ssh.forwardAgent = true')
    log "Cloning $golden → $name (mount: $dir${extra_mounts:+, +${#extra_mounts[@]} extra mount(s)})"
    limactl --tty=false clone "$golden" "$name" "${clone_args[@]}"
  fi
  [[ $ephemeral_sessions -eq 1 || $preexisting -eq 0 ]] || ensure_session_mount "$name" "$session_state"
  [[ $ssh_agent -eq 1 && $preexisting -eq 1 ]] && enable_ssh_agent "$name"

  _DB_NAME="$name"; _DB_DIR="$dir"; _DB_IMAGE="$image"; _DB_KEEP="$keep"
  _DB_SESSION_DIR=""; [[ $ephemeral_sessions -eq 1 ]] || _DB_SESSION_DIR="$session_state"
  trap run_cleanup EXIT INT TERM

  if [[ "$(instance_status "$name")" != "Running" ]]; then
    log "Booting $name…"; limactl start "$name"
  fi
  [[ $ssh_agent -eq 1 ]] && apply_git_signing "$name"

  local managed_proxy=""
  if [[ $no_auth -eq 1 ]]; then
    clear_auth "$name"
  else
    managed_proxy="$proxy"
    if [[ -z "$managed_proxy" && $preexisting -eq 1 ]]; then
      managed_proxy="$(stored_gh_proxy_endpoint "$name" || true)"
      [[ -z "$managed_proxy" ]] || log "Refreshing remembered GitHub CLI proxy for $name"
    fi
    [[ -z "$managed_proxy" ]] || {
      proxy_ensure "$managed_proxy"
      apply_proxy "$name" "$managed_proxy"
      start_gh_proxy_capability_renewal "$name" "$managed_proxy"
    }
    [[ -n "$api_keys"  ]] && apply_api_keys "$name" "$api_keys"
    [[ $with_creds -eq 1 ]] && apply_creds  "$name"
  fi

  local managed_traffic_audit="$traffic_audit" traffic_proxy_endpoint=""
  if [[ -z "$managed_traffic_audit" && $preexisting -eq 1 ]]; then
    traffic_proxy_endpoint="$(stored_traffic_proxy_endpoint "$name" || true)"
    if [[ -n "$traffic_proxy_endpoint" ]]; then
      managed_traffic_audit=connect
      log "Refreshing remembered proxy-or-fail traffic audit for $name"
    fi
  fi
  case "$managed_traffic_audit" in
    off) clear_connect_traffic_audit "$name";;
    connect)
      [[ -n "$traffic_proxy_endpoint" ]] || \
        traffic_proxy_endpoint="${proxy:-$PROXY_DEFAULT_URL}"
      proxy_ensure "$traffic_proxy_endpoint" || die "could not start traffic proxy"
      apply_connect_traffic_audit "$name" "$traffic_proxy_endpoint";;
  esac
  [[ $with_agent_config -eq 1 ]] && apply_agent_config "$name"
  if [[ ${#extra_copies[@]} -gt 0 ]]; then
    local c; for c in "${extra_copies[@]}"; do apply_copy "$name" "$c"; done
  fi
  if [[ $ephemeral_sessions -eq 1 ]]; then
    if [[ $preexisting -eq 1 ]]; then
      disable_session_persistence "$name" "$session_state"
      remove_session_mount "$name" "$session_state"
    fi
  else
    apply_session_persistence "$name" "$session_state"
  fi

  if [[ -n "$manifest" ]]; then
    local manifest_packages
    manifest_packages="$(manifest_json_value "$manifest" packages)"
    apply_project_packages "$name" "$manifest_packages"
    run_project_start "$name" "$dir" "$manifest_start"
  elif [[ -f "$dir/.devbox" ]]; then
    warn ".devbox is no longer executed; migrate it to $PROJECT_MANIFEST_NAME"
  fi

  if [[ $gui -eq 1 ]]; then
    if [[ ${#gui_command[@]} -gt 0 ]]; then
      run_gui "$name" "$dir" "${gui_command[@]}"
    else
      run_gui_shell "$name" "$dir"
    fi
    return
  fi

  local fate="destroy it"
  [[ $keep -eq 1 ]] && fate="leave it running"
  log "Entering $name — exit the shell to $fate."
  limactl shell --workdir "$dir" "$name" || true
}

cmd_gui() { cmd_run --gui "$@"; }

cmd_ls() { limactl list 2>/dev/null | awk 'NR==1 || $1 ~ /^devbox-/'; }

cmd_proxy() {
  local sub="${1:-status}" url="${DEVBOX_PROXY_URL:-$PROXY_DEFAULT_URL}" port pid launcher audit_sub audit_arg
  port="$(proxy_port "$url")"
  case "$sub" in
    start)  proxy_ensure "$url";;
    stop)   pid="$(cat "$CONFIG_DIR/proxy.pid" 2>/dev/null || true)"
            if [[ -n "$pid" ]] && kill "$pid" 2>/dev/null; then
              log "stopped AI proxy (pid $pid)"; rm -f "$CONFIG_DIR/proxy.pid"
            elif pkill -f 'devbox-ai-proxy\.py' 2>/dev/null; then log "stopped AI proxy (matched by name)"
            else warn "no running AI proxy found"; fi;;
    status) if proxy_health "$port"; then log "AI proxy: RUNNING on 127.0.0.1:$port"
            elif proxy_port_open "$port"; then warn "port $port held by another (non-devbox) service"
            else log "AI proxy: not running (port $port)"; fi;;
    audit) shift
           audit_sub="${1:-show}"
           launcher="$(proxy_launcher)" || die "proxy launcher not found"
           case "$audit_sub" in
             status) "$launcher" --audit-status;;
             show) audit_arg="${2:-50}"; "$launcher" --audit-show "$audit_arg";;
             export) audit_arg="${2:-}"; "$launcher" --audit-export "$audit_arg";;
             *) die "usage: devbox proxy audit [status|show [LIMIT]|export [FILE]]";;
           esac;;
    *) die "usage: devbox proxy [start|stop|status|audit]";;
  esac
}

session_state_in_use() { # $1 exact per-project state directory
  command -v limactl >/dev/null 2>&1 || return 1
  limactl list --json 2>/dev/null | python3 -c '
import json, sys
path = sys.argv[1]
try:
    items = [json.loads(line) for line in sys.stdin if line.strip()]
    used = any(
        mount.get("location") == path
        for item in items
        for mount in item.get("config", {}).get("mounts", [])
    )
    raise SystemExit(0 if used else 1)
except (json.JSONDecodeError, AttributeError, TypeError):
    raise SystemExit(2)
' "$1"
}

session_state_other_instance() { # $1 state directory $2 intended instance
  limactl list --json 2>/dev/null | python3 -c '
import json, sys
path, intended = sys.argv[1:]
for line in sys.stdin:
    if not line.strip():
        continue
    item = json.loads(line)
    if item.get("name") == intended:
        continue
    if any(m.get("location") == path for m in item.get("config", {}).get("mounts", [])):
        print(item.get("name", "unknown"))
        break
' "$1" "$2"
}

cmd_sessions() {
  local sub="${1:-path}" dir="$PWD" assume_yes=0 state
  [[ $# -eq 0 ]] || shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) assume_yes=1;;
      -h|--help) die "usage: devbox sessions [path|clear [--yes]] [DIR]";;
      -*) die "sessions: unknown flag: $1";;
      *) dir="$1";;
    esac
    shift
  done
  dir="$(abspath "$dir")"
  [[ -d "$dir" ]] || die "not a directory: $dir"
  state="$(project_session_dir "$dir")"
  validate_session_path "$state"
  case "$sub" in
    path) printf '%s\n' "$state";;
    clear)
      if [[ ! -e "$state" && ! -L "$state" ]]; then
        log "no persistent AI sessions for $dir"
        return 0
      fi
      [[ -d "$state" && ! -L "$state" ]] || die "refusing unexpected session path: $state"
      local mount_status=0
      if session_state_in_use "$state"; then
        die "session state is still mounted by a Devbox; destroy that box before clearing it"
      else
        mount_status=$?
        [[ $mount_status -eq 1 ]] || die "could not verify whether session state is still mounted"
      fi
      if [[ $assume_yes -eq 0 ]]; then
        [[ -t 0 ]] || die "sessions clear needs an interactive terminal or --yes"
        printf 'Delete persistent AI sessions for %s? [y/N] ' "$dir" >&2
        local answer=""; IFS= read -r answer
        [[ "$answer" == y || "$answer" == Y ]] || { log "cancelled."; return 0; }
      fi
      rm -rf -- "$state"
      log "deleted persistent AI sessions for $dir"
      ;;
    *) die "usage: devbox sessions [path|clear [--yes]] [DIR]";;
  esac
}

cmd_destroy() {
  local t="${1:-}"; [[ -n "$t" ]] || die "usage: devbox destroy NAME | --all | --goldens"
  local list
  case "$t" in
    --all|-A)     list="$(limactl list -q 2>/dev/null | grep '^devbox-' | grep -v '^devbox-golden' || true)";;
    --goldens|-G) list="$(limactl list -q 2>/dev/null | grep '^devbox-golden' || true)";;
    *)         list="$t";;
  esac
  [[ -n "$list" ]] || { log "nothing to destroy."; return 0; }
  while IFS= read -r i; do
    [[ -n "$i" ]] || continue
    log "destroying $i"
    limactl stop -f "$i" 2>/dev/null || true
    limactl delete -f "$i"
    clear_gh_proxy_endpoint "$i"
    clear_traffic_proxy_endpoint "$i"
  done <<< "$list"
}

usage() { grep -E '^#( |$)' "$0" | sed -E 's/^# ?//'; }

# ----------------------------------------------------------------- dispatch --
# Only when executed directly — sourcing (e.g. from the bats tests) loads the
# functions without running anything.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  case "${1:-}" in
    -h|--help|help) usage; exit 0;;
    -V|--version|version) printf 'devbox %s\n' "$DEVBOX_VERSION"; exit 0;;
    sessions)       shift; cmd_sessions "$@"; exit $?;;
  esac
  need limactl
  case "${1:-}" in
    build)          shift; cmd_build   "$@";;
    gui)            shift; cmd_gui     "$@";;
    ls|list)        shift; cmd_ls      "$@";;
    destroy|rm)     shift; cmd_destroy "$@";;
    proxy)          shift; cmd_proxy   "$@";;
    *)              cmd_run "$@";;
  esac
fi
